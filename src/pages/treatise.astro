  /* --- sections ----------------------------------------------------- */
  .t-sec {
    padding: 3.5rem 0 4.5rem;
    scroll-margin-top: 3.5rem;
    display: grid;
    grid-template-columns: 21rem minmax(0, 41rem);
    justify-content: center;
    column-gap: 4.25rem;
    align-items: start;
