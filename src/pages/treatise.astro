---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import { SITE_TITLE } from "../consts";
import fs from "node:fs";
import path from "node:path";

const entries = (await getCollection("treatise")).sort(
  (a, b) => a.data.order - b.data.order
);

// Part-level rubrics from Skeat's text (see src/content/treatise/_SOURCE.md).
const partRubric: Record<string, string> = {
  "Part I": "HERE BIGINNETH THE DESCRIPCION OF THE ASTROLABIE.",
  "Part II": "HERE BIGINNEN THE CONCLUSIONS OF THE ASTROLABIE.",
};

const partSlug: Record<string, string> = {
  "Part I": "part-1",
  "Part II": "part-2",
};
const anchor = (part: string, section: string) =>
  part === "Prologue" ? "prologue" : `${partSlug[part]}-${section}`;

// Optional modern text, read at build time from <dir>/<slug>.txt if the file exists.
// Morrison's translation is permitted on this branch only; publishing on the live site
// still needs a second permission (see src/treatise-text/morrison/README.md).
const PRIVATE_MODERN = { dir: "src/treatise-text/morrison", credit: "James E. Morrison" };
const privateModern = (slug: string): string[] | null => {
  const f = path.join(process.cwd(), PRIVATE_MODERN.dir, `${slug}.txt`);
  if (!fs.existsSync(f)) return null;
  return fs.readFileSync(f, "utf8").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
};

// On this page scenes are painted as miniatures: the same scene, gilded.
const illuminated: Record<string, string> = { "demo-rete": "illum-rete" };

// Skeat sets rubrics in capitals; a scribe would write them in a book hand.
const bookCase = (s: string) =>
  s.toLowerCase().replace(/^([^a-z]*)([a-z])/, (_, pre, c) => pre + c.toUpperCase());

// Painted drolleries in the outer margin, beside passages that name them.
const marginalia: Record<string, string> = {
  "part-2-1": "sun", // the degree of the sonne
  "part-2-3": "star", // the sterres fixe
};

const roman = (n: number) =>
  (["", "j", "ij", "iij", "iiij", "v", "vj", "vij", "viij", "ix", "x"][n] ?? String(n));

const firstWords = (body: string, n: number) =>
  body.trim().split(/\s+/).slice(0, n).join(" ").replace(/[,;:.]$/, "");

const sections = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    const { part, section } = entry.data;
    const body = entry.body.trim();
    return {
      entry,
      Content,
      id: anchor(part, section),
      privateModern: privateModern(entry.slug),
      initial: body.match(/[A-Za-z]/)?.[0]?.toUpperCase() ?? "",
      scene: entry.data.scene ? illuminated[entry.data.scene] ?? entry.data.scene : undefined,
    };
  })
);
const usesPrivate = sections.some((s) => s.privateModern);

// One leaf per part; leaf j is the title and table.
const runhead: Record<string, string> = {
  Prologue: "Prologus",
  "Part I": "Pars prima",
  "Part II": "Pars secunda",
};
const leaves = ["Prologue", "Part I", "Part II"].map((name, i, all) => {
  const items = sections.filter((s) => s.entry.data.part === name);
  const next = sections.find((s) => s.entry.data.part === all[i + 1]);
  return {
    name,
    items,
    folio: roman(i + 2),
    catch: next ? firstWords(next.entry.body, 3) : "",
  };
});
const firstCatch = firstWords(sections[0].entry.body, 3);
const folioOf = (part: string) => roman(["Prologue", "Part I", "Part II"].indexOf(part) + 2);
---

<BaseLayout
  title={`A Treatise on the Astrolabe - ${SITE_TITLE}`}
  description="Geoffrey Chaucer, A Treatise on the Astrolabe (c. 1391), in W. W. Skeat's Middle English text (1894)."
>
  <div class="treatise" data-view="both">
    <div class="codex">
      <fieldset class="t-view">
        <legend>Show</legend>
        <input type="radio" name="t-view" id="t-view-both" value="both" checked />
        <label for="t-view-both">Text &amp; glose</label>
        <input type="radio" name="t-view" id="t-view-me" value="me" />
        <label for="t-view-me">Text</label>
        <input type="radio" name="t-view" id="t-view-modern" value="modern" />
        <label for="t-view-modern">Glose</label>
      </fieldset>

      <!-- fo. j: title and table -->
      <article class="leaf leaf-title" aria-label="Title and contents">
        <div class="bd" aria-hidden="true">
          <span class="bd-v"></span><span class="bd-t"></span><span class="bd-b"></span>
          <span class="boss b-tl"></span><span class="boss b-bl"></span>
          <span class="boss b-tr"></span><span class="boss b-br"></span>
        </div>
        <p class="folio" aria-hidden="true">fo. j</p>

        <header class="title">
          <p class="title-incipit">Here biginneth the Tretis of the Astrolabie</p>
          <h1>
            <span class="init init-xl" aria-hidden="true"><span class="init-f"><span class="init-l">A</span></span></span>
            <span class="vh">A</span> Treatise <span class="title-on nw">on the</span> Astrolabe
          </h1>
          <p class="title-by">Geoffrey Chaucer, for Lowis his sone, <span class="nw">c. 1391</span></p>
        </header>

        <div class="title-body">
          <p class="credits">
            Middle English text: W. W. Skeat (1894).{usesPrivate && (
              <> Modern English: {PRIVATE_MODERN.credit}, written here in the margin as a glose.</>
            )}
          </p>
          {usesPrivate && (
            <p class="t-private">Draft preview; publication permission pending.</p>
          )}

          <nav class="t-toc" aria-label="Contents">
            <h2>Tabula</h2>
            <ol>
              {
                leaves.map((p) =>
                  p.name === "Prologue" ? (
                    p.items.map((s) => (
                      <li class="toc-top">
                        <a href={`#${s.id}`}>
                          <span class="toc-label">Prologue</span>
                          <span class="toc-lead" aria-hidden="true"></span>
                          <span class="toc-fo">fo. {p.folio}</span>
                        </a>
                      </li>
                    ))
                  ) : (
                    <li class="toc-top">
                      <span class="toc-part">{p.name}</span>
                      <ol>
                        {p.items.map((s, i) => (
                          <li>
                            <a href={`#${s.id}`}>
                              <span class={`toc-num ${i % 2 ? "blue" : "red"}`}>§ {s.entry.data.section}</span>
                              <span class="toc-label">
                                {s.entry.data.heading ? bookCase(s.entry.data.heading) : s.entry.body.trim().split(/\s+/).slice(0, 6).join(" ") + "…"}
                              </span>
                              <span class="toc-lead" aria-hidden="true"></span>
                              <span class="toc-fo">fo. {folioOf(p.name)}</span>
                            </a>
                          </li>
                        ))}
                      </ol>
                    </li>
                  )
                )
              }
            </ol>
          </nav>
        </div>
        <p class="catch" aria-hidden="true"><span>{firstCatch}</span></p>
      </article>

      {
        leaves.map((leaf) => (
          <article class="leaf" aria-label={leaf.name}>
            <div class="bd" aria-hidden="true">
              <span class="bd-v" />
              <span class="bd-t" />
              <span class="bd-b" />
              <span class="boss b-tl" />
              <span class="boss b-bl" />
              <span class="boss b-tr" />
              <span class="boss b-br" />
            </div>
            <p class="runhead" aria-hidden="true">
              {[...runhead[leaf.name]].map((c, i) => (
                <span class={i % 2 ? "blue" : "red"}>{c}</span>
              ))}
            </p>
            <p class="folio" aria-hidden="true">fo. {leaf.folio}</p>

            <div class="leaf-body">
              {leaf.name !== "Prologue" && (
                <header class="part-head">
                  <h2>{leaf.name}</h2>
                  <p class="part-rubric">{bookCase(partRubric[leaf.name])}</p>
                </header>
              )}
              {leaf.items.map(({ entry, Content, id, privateModern, initial, scene }, i) => (
                <section class="t-sec" id={id}>
                  <div class="t-main">
                    <header class="t-sec-head">
                      <h3>
                        <span class="renvoi" aria-hidden="true" />
                        {entry.data.part === "Prologue" ? (
                          "Prologue"
                        ) : (
                          <>
                            <span class="t-sec-num">§ {entry.data.section}.</span>{" "}
                            {entry.data.heading && bookCase(entry.data.heading)}
                          </>
                        )}
                      </h3>
                      {entry.data.latin && (
                        <p class="t-latin" lang="la">
                          {bookCase(entry.data.latin)}
                        </p>
                      )}
                    </header>
                    {scene && (
                      <figure class="mini">
                        <div class="mini-frame">
                          <div class="mini-band">
                            <div class="mini-ground">
                              <Scene
                                name={scene}
                                label={`Miniature of an astrolabe, for ${entry.data.part}${entry.data.part === "Prologue" ? "" : ` § ${entry.data.section}`}`}
                              />
                            </div>
                          </div>
                        </div>
                      </figure>
                    )}
                    <div
                      class:list={["t-me", { big: i === 0 }]}
                      lang="enm"
                    >
                      <span class="init" aria-hidden="true">
                        <span class="init-f">
                          <span class="init-l">{initial}</span>
                        </span>
                      </span>
                      <Content />
                    </div>
                  </div>
                  <aside class="t-gloss" aria-label="Modern English">
                    <p class="gl-lemma">
                      <span class="renvoi" aria-hidden="true" />
                      Glose
                    </p>
                    {privateModern ? (
                      privateModern.map((p) => <p>{p}</p>)
                    ) : entry.data.modern ? (
                      <p>{entry.data.modern}</p>
                    ) : (
                      <p class="t-pending">Modern rendering — pending</p>
                    )}
                    {marginalia[id] && (
                      <span class={`marg marg-${marginalia[id]}`} aria-hidden="true" />
                    )}
                  </aside>
                </section>
              ))}
            </div>
            {leaf.catch ? (
              <p class="catch" aria-hidden="true">
                <span>{leaf.catch}</span>
              </p>
            ) : (
              <p class="explicit">Explicit.</p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: "Junicode 2";
    src: url("/fonts/treatise/junicode/Junicode2-Roman.woff2") format("woff2");
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Texturina";
    src: url("/fonts/treatise/texturina/Texturina-VF.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "IM Fell English";
    src: url("/fonts/treatise/imfell/IMFellEnglish-Italic.woff2") format("woff2");
    font-weight: 400;
    font-style: italic;
    font-display: swap;
  }

  /* Let this page use the full width BaseLayout gives it. */
  main:has(> .treatise) {
    max-width: 1240px;
  }
  @media (min-width: 1000px) {
    .page-padding:has(.treatise) {
      padding-left: 40px;
      padding-right: 40px;
    }
  }
  /* The site sets p sizes globally; the leaves set their own. */
  .treatise p {
    font-size: inherit;
    line-height: inherit;
  }
  .page-wrapper:has(.treatise) {
    overflow-x: clip;
  }
  @media (max-width: 759.98px) {
    /* Let the lectern run edge to edge on phones. */
    main > .treatise {
      max-width: none;
      width: 100vw;
      margin-left: calc(50% - 50vw);
    }
  }
</style>

<style>
  .treatise {
    --ink: #2a1a0e;
    --sepia: #57391a;
    --red: #b3301c;
    --blue: #2b4c9b;
    --rose: #c0516b;
    --rule: rgba(160, 82, 60, 0.2);
    --gold: linear-gradient(
      135deg,
      #8a5a12 0%,
      #e6bf55 20%,
      #fff1b8 36%,
      #d6a43a 52%,
      #9b6a18 74%,
      #ecc65e 100%
    );
    --me-font: "Junicode 2", "Junicode", Georgia, serif;
    --black-font: "Texturina", var(--me-font);
    --gloss-font: "IM Fell English", "Junicode 2", Georgia, serif;
    --lh: 2.05rem;
    --gloss-w: 17.5rem;
    --gap: 2.75rem;
    position: relative;
    z-index: 1;
    margin-bottom: 3rem;
  }

  /* ---- The lectern: tooled leather behind the leaves ---- */
  .codex {
    position: relative;
    padding: 1.25rem 2.75rem 3rem;
    border-radius: 10px;
    background:
      url("/treatise-art/leather.svg") 0 0 / 96px 96px,
      radial-gradient(ellipse at 50% 0%, #6b3a20 0%, #45210f 55%, #2a130a 100%);
    box-shadow:
      inset 0 0 0 1px rgba(255, 220, 160, 0.08),
      inset 0 0 0 7px #2a130a,
      inset 0 0 0 8px rgba(225, 180, 90, 0.35),
      inset 0 0 60px rgba(0, 0, 0, 0.6),
      0 10px 30px rgba(40, 20, 5, 0.35);
  }

  /* View toggle: three gilt-tooled tabs, kept in reach. */
  .t-view {
    position: sticky;
    top: 0.5rem;
    z-index: 5;
    display: flex;
    justify-content: center;
    gap: 0.4rem;
    border: 0;
    padding: 0;
    margin: 0 auto 1.25rem;
    width: max-content;
    max-width: 100%;
  }
  .t-view legend {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .t-view input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .t-view label {
    font-family: var(--black-font);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    padding: 0.4rem 1rem 0.45rem;
    cursor: pointer;
    color: #ecd29a;
    background: linear-gradient(#5a2c15, #3a1a0b);
    border: 1px solid #1d0c04;
    box-shadow:
      inset 0 0 0 2px rgba(236, 198, 94, 0.25),
      0 2px 4px rgba(0, 0, 0, 0.4);
    border-radius: 3px;
    white-space: nowrap;
  }
  .t-view input:checked + label {
    color: #2a1a0e;
    background: var(--gold);
    box-shadow:
      inset 0 0 0 1px rgba(255, 250, 220, 0.6),
      0 2px 6px rgba(0, 0, 0, 0.5);
  }
  .t-view input:focus-visible + label {
    outline: 2px solid #ecd29a;
    outline-offset: 2px;
  }

  /* ---- A leaf of vellum ---- */
  .leaf {
    --pt: 8.25rem;
    --pr: 3.5rem;
    --pb: 8rem;
    --pl: 8.5rem;
    position: relative;
    max-width: 1080px;
    margin: 0 auto 2.75rem;
    padding: var(--pt) var(--pr) var(--pb) var(--pl);
    box-sizing: border-box;
    color: var(--ink);
    background:
      url("/treatise-art/vellum.svg") 0 0 / 420px 420px,
      radial-gradient(ellipse 80% 70% at 45% 40%, #f7ecd2 0%, #f0dfb9 60%, #e3c995 100%);
    border-radius: 4px 7px 5px 6px / 6px 4px 7px 5px;
    box-shadow:
      inset 0 0 80px rgba(135, 85, 25, 0.3),
      inset 0 0 6px rgba(120, 75, 20, 0.35),
      0 1px 0 #e9d4a5,
      3px 4px 0 -1px #d8be8a,
      6px 8px 0 -2px #c9ab73,
      0 22px 45px rgba(0, 0, 0, 0.55);
  }
  .leaf::selection,
  .leaf ::selection {
    background: rgba(43, 76, 155, 0.22);
  }

  /* Border: a bar of blue and rose with ivy, down the gutter and across head and foot. */
  .bd {
    --bar: 72px;
    --tile: 220px;
    --bx: 30px; /* left edge of the vertical tile */
    --by: 2.9rem; /* centre line of the top and bottom bars */
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .bd > span {
    position: absolute;
  }
  .bd-v {
    left: var(--bx);
    top: var(--by);
    bottom: var(--by);
    width: var(--bar);
    background: url("/treatise-art/vine-v.svg") 0 0 / var(--bar) var(--tile);
    background-repeat: no-repeat round;
  }
  .bd-t,
  .bd-b {
    left: calc(var(--bx) + var(--bar) / 2);
    right: calc(var(--pr) + 4.5rem);
    height: var(--bar);
    background: url("/treatise-art/vine-h.svg") 0 0 / var(--tile) var(--bar);
    background-repeat: round no-repeat;
  }
  .bd-t {
    top: calc(var(--by) - var(--bar) / 2);
  }
  .bd-b {
    bottom: calc(var(--by) - var(--bar) / 2);
    transform: scaleY(-1);
  }
  .boss {
    width: 36px;
    height: 36px;
    background: url("/treatise-art/boss.svg") 0 0 / 100% 100%;
    filter: drop-shadow(1px 1.5px 1px rgba(60, 30, 5, 0.45));
  }
  .b-tl,
  .b-bl {
    left: calc(var(--bx) + var(--bar) / 2 - 18px);
  }
  .b-tr,
  .b-br {
    right: calc(var(--pr) + 4.5rem - 18px);
  }
  .b-tl,
  .b-tr {
    top: calc(var(--by) - 18px);
  }
  .b-bl,
  .b-br {
    bottom: calc(var(--by) - 18px);
  }

  .folio {
    position: absolute;
    top: 2rem;
    right: var(--pr);
    margin: 0;
    font-family: var(--gloss-font);
    font-style: italic;
    font-size: 1.05rem;
    color: var(--sepia);
    opacity: 0.85;
  }
  .runhead {
    position: absolute;
    top: 5.6rem;
    left: var(--pl);
    right: calc(var(--pr) + var(--gloss-w) + var(--gap));
    margin: 0;
    text-align: center;
    font-family: var(--black-font);
    font-weight: 600;
    font-size: 1rem;
    letter-spacing: 0.22em;
  }
  .red {
    color: var(--red);
  }
  .blue {
    color: var(--blue);
  }

  .catch {
    position: absolute;
    bottom: 5rem;
    right: calc(var(--pr) + var(--gloss-w) + var(--gap));
    margin: 0;
    font-family: var(--me-font);
    font-size: 0.95rem;
    color: var(--ink);
  }
  .catch span {
    display: inline-block;
    padding: 0.05rem 0.7rem 0.1rem;
    border: 1px solid var(--red);
    border-radius: 0 0 40% 40% / 0 0 70% 70%;
    box-shadow: 2px 2px 0 -1px rgba(43, 76, 155, 0.6);
  }
  .explicit {
    position: absolute;
    bottom: 5rem;
    left: var(--pl);
    right: calc(var(--pr) + var(--gloss-w) + var(--gap));
    margin: 0;
    text-align: center;
    font-family: var(--black-font);
    font-weight: 600;
    color: var(--red);
    font-size: 1.2rem;
  }

  /* ---- Text block, with its frame ruling ---- */
  .leaf-body {
    --rl: rgba(160, 82, 60, 0.3);
    position: relative;
  }
  .leaf-body::before {
    /* Vertical bounding rules: either side of the text block and of the gloss column. */
    content: "";
    position: absolute;
    top: -1.25rem;
    bottom: -1.5rem;
    left: -0.9rem;
    right: -0.9rem;
    pointer-events: none;
    background:
      linear-gradient(var(--rl), var(--rl)) 0 0 / 1px 100% no-repeat,
      linear-gradient(var(--rl), var(--rl)) 5px 0 / 1px 100% no-repeat,
      linear-gradient(var(--rl), var(--rl))
        calc(100% - var(--gloss-w) - var(--gap) / 2 - 0.9rem) 0 / 1px 100% no-repeat,
      linear-gradient(var(--rl), var(--rl)) 100% 0 / 1px 100% no-repeat;
  }

  .part-head {
    position: relative;
    text-align: center;
    margin: 0 calc(var(--gloss-w) + var(--gap)) 1.6rem 0;
  }
  .part-head h2 {
    font-family: var(--black-font);
    font-weight: 700;
    font-variation-settings: "opsz" 72;
    font-size: 2.6rem;
    line-height: 1.1;
    color: var(--blue);
    margin: 0;
    text-shadow: 1px 1px 0 rgba(255, 250, 230, 0.6);
  }
  .part-head h2::before,
  .part-head h2::after {
    /* Penwork line-fillers either side of the heading. */
    content: "";
    display: inline-block;
    vertical-align: middle;
    width: 3.5rem;
    height: 0.6rem;
    margin: 0 0.8rem;
    background:
      radial-gradient(circle, var(--red) 0 2px, transparent 2.5px) 0 50% / 0.6rem 0.6rem repeat-x,
      linear-gradient(var(--blue), var(--blue)) 0 50% / 100% 1px no-repeat;
  }
  .part-rubric {
    font-family: var(--black-font);
    font-weight: 500;
    color: var(--red);
    font-size: 1.3rem;
    margin: 0.3rem 0 0;
  }

  .t-sec {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--gloss-w);
    column-gap: var(--gap);
    scroll-margin-top: 4rem;
  }
  .t-sec + .t-sec {
    margin-top: calc(var(--lh) * 1.25);
  }

  .t-sec-head h3 {
    font-family: var(--black-font);
    font-weight: 600;
    color: var(--red);
    font-size: 1.28rem;
    line-height: 1.4;
    margin: 0 0 0.5rem;
  }
  .t-sec-num {
    color: var(--blue);
    font-weight: 700;
  }
  .t-latin {
    font-family: var(--me-font);
    font-style: normal;
    font-size: 0.92rem;
    line-height: 1.45;
    letter-spacing: 0.02em;
    color: var(--red);
    margin: 0 0 0.9rem;
    opacity: 0.9;
  }
  .renvoi {
    /* Signe de renvoi: ties a passage to its glose. */
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-right: 0.4em;
    vertical-align: 0.05em;
    border-radius: 50%;
    border: 1.5px solid var(--red);
    background:
      linear-gradient(var(--red), var(--red)) 50% 50% / 1.5px 100% no-repeat,
      linear-gradient(var(--red), var(--red)) 50% 50% / 100% 1.5px no-repeat;
    box-sizing: border-box;
  }

  /* Middle English: iron-gall ink on ruled lines. */
  .t-me {
    font-family: var(--me-font);
    font-weight: 400;
    font-size: 1.24rem;
    line-height: var(--lh);
