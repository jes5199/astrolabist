  /* The figure stays in view beside its passage while it is read. */
  .t-aside {
    position: sticky;
    top: max(5rem, calc(50vh - 11rem));
  }
  .t-sec-label {
    margin-bottom: 2.25rem;
  }

  .win {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
  }
  .win-ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .t-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  .ring-text {
    fill: var(--gold);
    font-family: var(--me-font);
    font-size: 8.6px;
    letter-spacing: 2.6px;
    font-weight: 600;
  }
  .win-glass {
    position: absolute;
    inset: 10.83%;
    border-radius: 50%;
    overflow: hidden;
    background: radial-gradient(circle at 50% 38%, #18225a 0%, #0b1236 55%, #050816 100%);
    box-shadow:
      0 0 0 1px rgba(236, 201, 120, 0.35),
      0 0 40px 6px rgba(80, 100, 220, 0.22),
      inset 0 0 30px rgba(0, 0, 0, 0.7);
    color: var(--gold);
    /* Scene labels ("25½°", "X", "Alhabor") inherit the treatise's face. */
    font-family: var(--me-font);
    --text-hover: #cfdcff;
    --header-color: var(--gold);
  }
  .win-stars {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: #e2e8ff;
