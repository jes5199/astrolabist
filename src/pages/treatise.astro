    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }
  .sky-rete {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .sky.ready canvas {
    opacity: 1;
  }

  .dusk,
  .dawn {
    position: absolute;
    left: 0;
    right: 0;
    z-index: 1;
    pointer-events: none;
  }
  .dusk {
    top: 0;
