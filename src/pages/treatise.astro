    position: relative;
    isolation: isolate;
    padding-left: 1.9rem;
  }
  /* A sky window set into the Middle English, after the words it shows.
     Wide: floated beside the following lines, which wrap round its circle.
     Narrow: on its own line. */
  .inline-win {
    float: right;
