  /* --- narrow screens ----------------------------------------------- */
  @media (max-width: 999.98px) {
    .t-inner {
      padding: 0 1.25rem;
    }
    .t-hero {
      padding-top: 370px;
    }
    .moon {
      width: 110px;
      height: 110px;
      right: 8%;
      top: 70px;
    }
    .evening-star {
      left: 16%;
      top: 200px;
    }
    .t-kicker {
      letter-spacing: 0.24em;
      font-size: 0.78rem;
    }
    .t-toc {
      margin-top: 3.5rem;
    }
    .t-sec {
      padding: 2.5rem 0 3rem;
    }
    .t-aside,
    .t-sec[data-side="r"] .t-aside {
