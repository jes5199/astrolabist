    float: left;
    font-size: 3.7em;
    line-height: 0.84;
    padding: 0.06em 0.1em 0 0;
    text-shadow:
      0 0 18px rgba(236, 201, 120, 0.55),
      0 0 2px rgba(255, 240, 200, 0.8);
  }
  /* The sky itself recedes behind text: see the veils in treatise-sky.ts. */
  .t-const {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .t-const :global(path) {
    fill: none;
    stroke: rgba(200, 212, 255, 0.42);
    stroke-width: 0.8;
  }
  .t-const :global(.c-star) {
    fill: #f4f6ff;
  }
  .t-const :global(.c-glow) {
    fill: rgba(160, 180, 255, 0.22);
  }
  .t-const :global(.c-star.gold) {
    fill: #ffe7b0;
  }

  /* --- glossed words ------------------------------------------------ */
  :global(.gw) {
    position: relative;
    cursor: help;
    border-radius: 2px;
    text-decoration: underline dotted rgba(236, 201, 120, 0.6);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.32em;
    text-decoration-skip-ink: none;
    transition: color 0.15s, text-shadow 0.15s, background-color 0.15s;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.gw-minor) {
    text-decoration-color: rgba(236, 201, 120, 0.3);
  }
  :global(.gw-ours) {
    text-decoration-color: rgba(190, 200, 235, 0.3);
  }
  :global(.gw:hover),
  :global(.gw[aria-expanded="true"]) {
    color: #fff6dc;
    text-decoration-color: var(--gold);
    text-shadow: 0 0 12px rgba(255, 220, 150, 0.55);
  }
  :global(.gw:focus) {
    outline: none;
  }
  :global(.gw:focus-visible) {
    outline: 1.5px solid var(--gold);
    outline-offset: 2px;
  }
  :global(.gw[data-fig]) {
    text-decoration-style: solid;
    text-decoration-thickness: 1px;
    text-decoration-color: rgba(236, 201, 120, 0.62);
  }
  /* Interlinear glosses (show-all mode): small, centred under the word. */
  :global(.gw-i) {
    display: none;
  }
  .treatise[data-gloss="all"] .t-sec[data-glossed] .t-me :global(p) {
    line-height: 2.4;
  }
  .treatise[data-gloss="all"] :global(.gw-i) {
    display: block;
    position: absolute;
    left: 50%;
    top: 1.3em;
    transform: translateX(-50%);
    max-width: max(calc(100% + 0.6em), 5.4em);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-family: var(--modern-font);
    font-style: italic;
    font-size: 0.64em;
    line-height: 1.3;
    letter-spacing: 0.01em;
    color: #ead9b0;
    text-shadow: 0 0 6px rgba(6, 9, 24, 0.9);
    pointer-events: none;
  }
  .treatise[data-gloss="all"] :global(.gw) {
    text-decoration-color: transparent;
  }

  /* The popover: one shared element, placed by script. */
  .gl-pop {
    position: fixed;
    z-index: 50;
    left: 0;
    top: 0;
    width: min(21rem, calc(100vw - 24px));
    box-sizing: border-box;
    padding: 0.85rem 1rem 0.75rem;
    border-radius: 10px;
    background: #0b1030;
    border: 1px solid rgba(236, 201, 120, 0.45);
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.6),
      0 0 0 4px rgba(11, 16, 48, 0.55),
      0 0 30px rgba(120, 140, 255, 0.16);
    color: #eef0fa;
    font-family: var(--modern-font);
    font-size: 1.04rem;
    line-height: 1.42;
    pointer-events: auto;
  }
  .gl-pop[hidden] {
    display: none;
  }
  .gl-pop::before {
    content: "";
    position: absolute;
    left: var(--ax, 50%);
    width: 10px;
    height: 10px;
    background: #0b1030;
    border: solid rgba(236, 201, 120, 0.45);
    transform: translateX(-50%) rotate(45deg);
  }
  .gl-pop[data-place="below"]::before {
    top: -6px;
    border-width: 1px 0 0 1px;
  }
  .gl-pop[data-place="above"]::before {
    bottom: -6px;
    border-width: 0 1px 1px 0;
  }
  .gl-pop p {
    margin: 0;
    line-height: inherit;
  }
  .gp-w {
    font-family: var(--me-font);
    font-size: 0.86rem;
    letter-spacing: 0.08em;
    color: #f3dfa8;
    margin-bottom: 0.2rem !important;
  }
  .gp-g {
    font-size: 1.14rem;
    font-weight: 500;
    color: #ffffff;
  }
  .gp-d {
    margin-top: 0.4rem !important;
    font-size: 0.96rem;
    color: #e0e4f3;
  }
  .gp-d:empty,
  .gl-pop:not([data-fig]) .gp-fig {
    display: none;
  }
  .gp-fig {
    margin-top: 0.45rem !important;
    font-family: var(--me-font);
    font-size: 0.74rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #f3dfa8;
  }
  .gp-fig::before {
    content: "✦ ";
  }
  .gp-s {
    margin-top: 0.55rem !important;
    padding-top: 0.45rem;
    border-top: 1px solid rgba(236, 201, 120, 0.22);
    font-size: 0.8rem;
    line-height: 1.35;
    color: #c9cfe6;
  }
  .gp-s1,
  .gp-s2 {
    display: block;
  }
  .gp-s2:empty {
    display: none;
  }
  .gl-pop[data-ours] .gp-s {
    font-style: italic;
  }

  /* A figure lights up while one of the words it shows is glossed. */
  .t-sec .win.lit,
  .inline-win .win.lit {
    filter: none;
  }
  .win.lit .win-glass {
    box-shadow:
      0 0 0 2px rgba(255, 226, 160, 0.95),
      0 0 60px 16px rgba(255, 214, 130, 0.38),
      inset 0 0 30px rgba(0, 0, 0, 0.7);
  }
  .win.lit .win-ring {
    filter: drop-shadow(0 0 6px rgba(255, 220, 150, 0.8));
  }

  /* Morrison's rendering, folded under the Middle English. */
  .t-morrison {
    margin: 1.6rem 0 0;
    border-top: 1px solid var(--hair);
    padding-top: 0.9rem;
    font-family: var(--modern-font);
  }
  .t-morrison summary {
    cursor: pointer;
    width: max-content;
    max-width: 100%;
    font-family: var(--me-font);
    font-size: 0.8rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    padding: 0.25rem 0;
  }
  .t-morrison summary:hover {
    color: var(--gold);
  }
  .t-morrison summary:focus-visible {
    outline: 1px solid var(--gold);
    outline-offset: 2px;
  }
  .tm-body {
    margin-top: 0.9rem;
    font-size: 1.12rem;
    line-height: 1.62;
    color: var(--gold-soft);
  }
  .tm-body p {
    margin: 0 0 0.9em;
  }
  .tm-credit {
    font-size: 0.92rem;
    color: #cfd5ec;
  }

  .t-sample-end {
    max-width: 34rem;
    margin: 0.5rem auto 3rem;
    padding: 1rem 1.4rem;
    text-align: center;
    font-family: var(--modern-font);
    font-size: 1.02rem;
    line-height: 1.5;
    color: #d6dbef;
    border: 1px dashed var(--hair);
    border-radius: 999px;
  }
  .t-sample-end p {
    margin: 0;
  }

  /* --- the end ------------------------------------------------------ */
  .t-end {
    text-align: center;
    padding: 6rem 0 560px;
  }
  .t-explicit {
    font-family: var(--black-font);
    font-weight: 600;
    font-size: 2.6rem;
    color: var(--gold);
    margin: 0 0 1rem;
    text-shadow: 0 0 20px rgba(236, 201, 120, 0.35);
  }
  .t-credit {
    font-family: var(--modern-font);
    font-size: 1.02rem;
    color: #d6dbef;
    max-width: 34rem;
    margin: 0 auto;
  }

  /* --- narrow screens ----------------------------------------------- */
  @media (max-width: 999.98px) {
    .t-inner {
      padding: 0 1.25rem;
    }
    .t-hero {
      padding-top: 370px;
    }
    .moon {
      width: 110px;
      height: 110px;
      right: 8%;
      top: 70px;
    }
    .evening-star {
      left: 16%;
      top: 200px;
    }
    .t-kicker {
      letter-spacing: 0.24em;
      font-size: 0.78rem;
    }
    .t-toc {
      margin-top: 3.5rem;
    }
    .t-sec {
      padding: 2.5rem 0 3rem;
    }
    .t-sec,
    .t-sec[data-side="r"] {
      display: block;
    }
    .t-aside {
      position: static;
      margin-bottom: 1.5rem;
    }
    .t-sec-label,
    .t-sec[data-side="r"] .t-sec-label {
      text-align: center;
      margin-bottom: 2rem;
    }
    .win {
      width: min(15rem, 68vw);
      margin: 0 auto;
    }
    /* Long Part II rubrics: small capitals, tighter tracking. */
    .t-sec-label h3 {
      font-size: 1.15rem;
      line-height: 1.45;
      letter-spacing: 0.07em;
      font-variant-caps: all-small-caps;
    }
    .t-sec-label h3::after,
    .t-sec[data-side="r"] .t-sec-label h3::after {
      margin: 0.9rem auto 0;
      background: linear-gradient(90deg, rgba(236, 201, 120, 0), var(--gold), rgba(236, 201, 120, 0));
    }
    .t-body {
      padding-left: 1.6rem;
    }
    .inline-win {
      float: none;
      width: min(15rem, 68vw);
      margin: 0.4rem auto 1.6rem;
      shape-outside: none;
    }
    .t-me {
      font-size: 1.16rem;
      line-height: 1.68;
    }
    .gl-bar {
      padding-left: 0.9rem;
      gap: 0.6rem;
    }
    .gl-all {
      letter-spacing: 0.1em;
      padding-inline: 0.8rem;
    }
    .gl-hint {
      font-size: 0.88rem;
    }
    .t-end {
      padding-bottom: 520px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sky-rete,
    .t-sec .win,
    .toc-star {
      transition: none;
    }
  }
</style>

<script>
  import { initSky } from "../scripts/treatise-sky";

  const root = document.querySelector<HTMLElement>(".treatise");
  if (root) {
    initSky(root);

    // --- Glosses ---------------------------------------------------------
    // Every glossed word is a span[role=button] with data-g (its entry) and
    // aria-describedby (a hidden description, for screen readers). One shared
    // popover shows the gloss: on hover (mouse), on tap (touch: tap again or tap
    // elsewhere to close), and on keyboard focus (Enter toggles, Escape closes).
    type GD = { g: string; d: string | null; s: string; ds: string | null; o: 0 | 1 };
    const GLOSS: Record<string, GD> = JSON.parse(document.getElementById("gl-data")?.textContent || "{}");
    const pop = document.getElementById("gl-pop") as HTMLElement | null;
    const words = [...root.querySelectorAll<HTMLElement>(".gw")];
    // Mark the words the section's own figure shows.
    root.querySelectorAll<HTMLElement>(".t-sec[data-figure-terms]").forEach((sec) => {
      const terms = new Set((sec.dataset.figureTerms ?? "").split(" "));
      sec.querySelectorAll<HTMLElement>(".gw").forEach((w) => {
        if (terms.has(w.dataset.g ?? "")) w.dataset.fig = "";
      });
    });
    let open: HTMLElement | null = null;
    let pinned = false;
    let hideT = 0;
    let lit: HTMLElement | null = null;
    const figureOf = (w: HTMLElement) => {
      if (!("fig" in w.dataset)) return null;
      // An inline window inside the same paragraph run wins (the sword), else the section's own.
      const sec = w.closest(".t-sec");
      const inl = w.dataset.g && ["swerd", "sleen", "envye"].includes(w.dataset.g) ? sec?.querySelector<HTMLElement>(".inline-win .win") : null;
      return inl ?? sec?.querySelector<HTMLElement>(".t-aside .win") ?? null;
    };
    const place = () => {
      if (!pop || !open) return;
      const r = open.getClientRects()[0] ?? open.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const m = 10;
      pop.style.left = "0px";
      pop.style.top = "0px";
      const pw = pop.offsetWidth;
      const ph = pop.offsetHeight;
      const cx = r.left + r.width / 2;
      const left = Math.max(m, Math.min(vw - pw - m, cx - pw / 2));
      const below = r.bottom + 12;
      const above = r.top - 12 - ph;
      // Prefer below; flip above when it would run off the bottom and there is room above.
      const useAbove = below + ph > vh - m && above >= m;
      const top = useAbove ? above : Math.min(below, Math.max(m, vh - ph - m));
      pop.dataset.place = useAbove ? "above" : "below";
      pop.style.left = `${Math.round(left)}px`;
      pop.style.top = `${Math.round(top)}px`;
      pop.style.setProperty("--ax", `${Math.round(Math.max(14, Math.min(pw - 14, cx - left)))}px`);
    };
    const close = () => {
      window.clearTimeout(hideT);
      if (open) open.setAttribute("aria-expanded", "false");
      lit?.classList.remove("lit");
      lit = null;
      open = null;
      pinned = false;
      if (pop) pop.hidden = true;
    };
    const show = (w: HTMLElement, pin = false) => {
      window.clearTimeout(hideT);
      const d = GLOSS[w.dataset.g ?? ""];
      if (!pop || !d) return;
      if (open && open !== w) open.setAttribute("aria-expanded", "false");
      open = w;
      pinned = pin;
      w.setAttribute("aria-expanded", "true");
      const q = (c: string) => pop.querySelector<HTMLElement>(c)!;
      q(".gp-w").textContent = w.firstChild?.textContent ?? "";
      q(".gp-g").textContent = d.g;
      q(".gp-d").textContent = d.d ?? "";
      q(".gp-s1").textContent = d.s;
      q(".gp-s2").textContent = d.ds ? `Definition: ${d.ds}` : "";
      if (d.o) pop.dataset.ours = "";
      else delete pop.dataset.ours;
      const fig = figureOf(w);
      if (fig) pop.dataset.fig = "";
      else delete pop.dataset.fig;
      if (lit !== fig) {
        lit?.classList.remove("lit");
        fig?.classList.add("lit");
        lit = fig;
      }
      pop.hidden = false;
      place();
    };
    const later = () => {
      window.clearTimeout(hideT);
      hideT = window.setTimeout(() => {
        if (!pinned) close();
      }, 180);
    };
    // Was this word's gloss already open (and pinned, or opened by touch) when the press began?
    // Focus opens a gloss on press, so the click that follows must not read it as a second tap.
    let pressWasOpen: boolean | null = null;
    for (const w of words) {
      w.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") show(w, pinned && open === w);
      });
      w.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse" && !pinned) later();
      });
      w.addEventListener("pointerdown", (e) => {
        pressWasOpen = open === w && (pinned || e.pointerType !== "mouse");
      });
      w.addEventListener("click", (e) => {
        e.preventDefault();
        // Touch / pen: a tap toggles. Mouse: a click pins the gloss open (or closes a pinned one).
        const was = pressWasOpen ?? (open === w && pinned);
        pressWasOpen = null;
        if (was) close();
        else show(w, true);
      });
      w.addEventListener("focus", () => {
        if (open !== w) show(w, false);
      });
      w.addEventListener("blur", () => {
        if (!pinned) later();
      });
      w.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          if (open === w && pinned) close();
          else show(w, true);
        } else if (e.key === "Escape" && open) {
          e.preventDefault();
          close();
        }
      });
    }
    pop?.addEventListener("pointerenter", () => window.clearTimeout(hideT));
    pop?.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse" && !pinned) later();
    });
    document.addEventListener("pointerdown", (e) => {
      const t = e.target as Node;
      if (open && !open.contains(t) && !pop?.contains(t)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) close();
    });
    let raf = 0;
    const follow = () => {
      if (!open) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        if (!open) return;
        const r = open.getBoundingClientRect();
        // Scrolled well away: let it go.
        if (r.bottom < -40 || r.top > window.innerHeight + 40) close();
        else place();
      });
    };
    window.addEventListener("scroll", follow, { passive: true });
    window.addEventListener("resize", follow);

    // Show-all mode: interlinear glosses under every glossed word. Remembered per viewer.
    const KEY = "treatise-gloss-all";
    const allBtn = root.querySelector<HTMLButtonElement>(".gl-all");
    const setAll = (on: boolean) => {
      root.dataset.gloss = on ? "all" : "hover";
      allBtn?.setAttribute("aria-pressed", String(on));
      close();
    };
    try {
      if (localStorage.getItem(KEY) === "1") setAll(true);
    } catch {
      /* storage unavailable */
    }
    allBtn?.addEventListener("click", () => {
      const on = root.dataset.gloss !== "all";
      setAll(on);
      try {
        localStorage.setItem(KEY, on ? "1" : "0");
      } catch {
        /* storage unavailable */
      }
      bodies.forEach(drawConst);
    });

    // Each section's paragraphs become a constellation strung down the left margin.
    const SVGNS = "http://www.w3.org/2000/svg";
    const drawConst = (body: HTMLElement) => {
      const svg = body.querySelector<SVGSVGElement>(".t-const");
      if (!svg) return;
      svg.replaceChildren();
      const box = body.getBoundingClientRect();
      if (!box.width) return;
      const pts: { x: number; y: number; first: boolean }[] = [];
      const ps = [...body.querySelectorAll<HTMLElement>(".t-me > p")];
      ps.forEach((p, i) => {
        const r = p.getBoundingClientRect();
        const lh = parseFloat(getComputedStyle(p).lineHeight) || 24;
        pts.push({ x: i % 2 ? 11 : 4, y: r.top - box.top + Math.min(lh, 40) * 0.55, first: i === 0 });
      });
      if (!pts.length) return;
      const path = document.createElementNS(SVGNS, "path");
      path.setAttribute("d", pts.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(""));
      svg.appendChild(path);
      for (const p of pts) {
        const r = p.first ? 2.8 : 1.7;
        const g = document.createElementNS(SVGNS, "circle");
        g.setAttribute("class", "c-glow");
        g.setAttribute("cx", p.x.toFixed(1));
        g.setAttribute("cy", p.y.toFixed(1));
        g.setAttribute("r", String(r * 3));
        svg.appendChild(g);
        const c = document.createElementNS(SVGNS, "circle");
        c.setAttribute("class", "c-star gold");
        c.setAttribute("cx", p.x.toFixed(1));
        c.setAttribute("cy", p.y.toFixed(1));
        c.setAttribute("r", String(r));
        svg.appendChild(c);
      }
    };
    const bodies = [...root.querySelectorAll<HTMLElement>(".t-body")];
    const ro = new ResizeObserver((es) => es.forEach((e) => drawConst(e.target as HTMLElement)));
    bodies.forEach((b) => ro.observe(b));
    document.fonts?.ready.then(() => bodies.forEach(drawConst));

    // Contents: join each part's stars with a faint line, and show the
    // title of the star under the pointer / keyboard focus (or of the
    // section being read) in the caption below the chart.
    const drawBand = (band: HTMLElement) => {
      const svg = band.querySelector<SVGSVGElement>(".toc-lines");
      if (!svg) return;
      const box = band.getBoundingClientRect();
      const pts = [...band.querySelectorAll<HTMLElement>(".toc-star")].map((st) => {
        const r = st.getBoundingClientRect();
        return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
      });
      const path = document.createElementNS(SVGNS, "path");
      // A new row starts a new stroke, so no line runs back across the band.
      path.setAttribute(
        "d",
        pts.map(([x, y], i) => `${i && x > pts[i - 1][0] ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join("")
      );
      svg.replaceChildren(path);
    };
    const bands = [...root.querySelectorAll<HTMLElement>(".toc-band")];
    const bandRO = new ResizeObserver((es) => es.forEach((e) => drawBand(e.target as HTMLElement)));
    bands.forEach((b) => bandRO.observe(b));
    document.fonts?.ready.then(() => bands.forEach(drawBand));

    const capK = root.querySelector<HTMLElement>(".toc-ck");
    const capT = root.querySelector<HTMLElement>(".toc-ct");
    let pointed: HTMLElement | null = null;
    let reading: HTMLElement | null = null;
    const showCaption = () => {
      const a = pointed ?? reading;
      if (!a || !capK || !capT) return;
      capK.textContent = a.dataset.captionKicker ?? "";
      capT.textContent = `${a.dataset.caption ?? ""}…`;
    };
    root.querySelectorAll<HTMLElement>(".toc-band a").forEach((a) => {
      const on = () => {
        pointed = a;
        showCaption();
      };
      const off = () => {
        if (pointed === a) {
          pointed = null;
          showCaption();
        }
      };
      a.addEventListener("pointerenter", on);
      a.addEventListener("focus", on);
      a.addEventListener("pointerleave", off);
      a.addEventListener("blur", off);
    });

    // Mark the section in view as active (window glow + contents star).
    const links = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>(".toc-band [data-toc]").forEach((a) => links.set(a.dataset.toc!, a));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          e.target.classList.toggle("active", e.isIntersecting);
          const link = links.get(e.target.id);
          link?.classList.toggle("active", e.isIntersecting);
          if (e.isIntersecting && link) {
            reading = link;
            showCaption();
          }
        }
      },
      { rootMargin: "-35% 0px -45% 0px" }
    );
    root.querySelectorAll(".t-sec").forEach((s) => io.observe(s));
  }
</script>
