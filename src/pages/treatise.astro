---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import Exploded from "../components/treatise/Exploded.astro";
import { SITE_TITLE } from "../consts";
import {
  instrumentFront,
  instrumentBack,
  INSTRUMENT_VIEWBOX,
  type Station,
} from "../lib/treatise/astrolabe";
import fs from "node:fs";
import path from "node:path";

const entries = (await getCollection("treatise")).sort(
  (a, b) => a.data.order - b.data.order
);

// Part-level rubrics from Skeat's text (see src/content/treatise/_SOURCE.md).
const partRubric: Record<string, string> = {
  "Part I": "HERE BIGINNETH THE DESCRIPCION OF THE ASTROLABIE.",
  "Part II": "HERE BIGINNEN THE CONCLUSIONS OF THE ASTROLABIE.",
};
const partLatin: Record<string, string> = {
  Prologue: "PROLOGVS",
  "Part I": "PARS PRIMA",
  "Part II": "PARS SECVNDA",
};
const partRoman: Record<string, string> = { "Part I": "I", "Part II": "II" };

const partSlug: Record<string, string> = {
  "Part I": "part-1",
  "Part II": "part-2",
};
const anchor = (part: string, section: string) =>
  part === "Prologue" ? "prologue" : `${partSlug[part]}-${section}`;

// Short captions engraved on the contents ring. Presentation only; the
// headings themselves stay as Skeat gives them.
const caption: Record<string, string> = {
  prologue: "PROLOGUE · TO LOWIS",
  "part-1-1": "I · 1 · THE RING",
  "part-1-2": "I · 2 · THE TURET",
  "part-1-3": "I · 3 · THE MODER",
  "part-2-1": "II · 1 · DEGREE OF THE SONNE",
  "part-2-2": "II · 2 · THE ALTITUDE",
  "part-2-3": "II · 3 · TYME OF DAY & NIGHT",
};
const plainCaption: Record<string, string> = {
  prologue: "To Lowis, my sone",
  "part-1-1": "Of the ring",
  "part-1-2": "Of the turet",
  "part-1-3": "Of the moder",
};

// Optional modern text, read at build time from <dir>/<slug>.txt if the file exists.
// Morrison's translation is permitted on this branch only; publishing on the live site
// still needs a second permission (see src/treatise-text/morrison/README.md).
const PRIVATE_MODERN = { dir: "src/treatise-text/morrison", credit: "James E. Morrison" };
const privateModern = (slug: string): string[] | null => {
  const f = path.join(process.cwd(), PRIVATE_MODERN.dir, `${slug}.txt`);
  if (!fs.existsSync(f)) return null;
  return fs.readFileSync(f, "utf8").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
};

const sections = await Promise.all(
  entries.map(async (entry) => {
    const { Content } = await entry.render();
    const { part, section } = entry.data;
    return { entry, Content, id: anchor(part, section), privateModern: privateModern(entry.slug) };
  })
);
const usesPrivate = sections.some((s) => s.privateModern);

const parts = ["Prologue", "Part I", "Part II"].map((name) => ({
  name,
  items: sections.filter((s) => s.entry.data.part === name),
}));

// Stations round the contents ring, evenly spaced from just past the throne.
const A0 = 28;
const A1 = 332;
const step = sections.length > 1 ? (A1 - A0) / (sections.length - 1) : 0;
const stations: Station[] = sections.map((s, i) => ({
  id: s.id,
  label: caption[s.id] ?? s.id.toUpperCase(),
  angle: A0 + i * step,
}));
const front = instrumentFront(stations);
const back = instrumentBack(-38);

const medal = (part: string, section: string) =>
  part === "Prologue" ? ["", "P"] : [partRoman[part], section];

// Mobile: a slice of the limb across the top of the screen.
const ARC = { cx: 180, cy: 412, r: 400, span: 22 };
const arcPt = (r: number, a: number) => {
  const t = (a * Math.PI) / 180;
  return [ARC.cx + r * Math.sin(t), ARC.cy - r * Math.cos(t)];
};
const arcPath = (r: number) => {
  const [x0, y0] = arcPt(r, -ARC.span - 2);
  const [x1, y1] = arcPt(r, ARC.span + 2);
  return `M${x0.toFixed(1)} ${y0.toFixed(1)} A ${r} ${r} 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
};
const arcTicks = (() => {
  const out: string[] = [];
  for (let i = -48; i <= 48; i++) {
    const a = i / 2;
    const len = i % 10 === 0 ? 7 : i % 2 === 0 ? 4.5 : 2.5;
    const [x0, y0] = arcPt(ARC.r, a);
    const [x1, y1] = arcPt(ARC.r - len, a);
    out.push(`M${x0.toFixed(1)} ${y0.toFixed(1)}L${x1.toFixed(1)} ${y1.toFixed(1)}`);
  }
  return out.join("");
})();
const mStation = (i: number) =>
  sections.length > 1 ? -ARC.span + 1 + (i * (2 * ARC.span - 2)) / (sections.length - 1) : 0;
---

<BaseLayout
  title={`A Treatise on the Astrolabe - ${SITE_TITLE}`}
  description="Geoffrey Chaucer, A Treatise on the Astrolabe (c. 1391), in W. W. Skeat's Middle English text (1894)."
>
  <div
    class="treatise"
    data-view="both"
    data-a0={A0}
    data-a1={A1}
    data-arc-span={ARC.span}
  >
    <fieldset class="t-view">
      <legend>Text shown</legend>
      <input type="radio" name="t-view" id="t-view-me" value="me" />
      <input type="radio" name="t-view" id="t-view-both" value="both" checked />
      <input type="radio" name="t-view" id="t-view-modern" value="modern" />
    </fieldset>

    <div class="t-layout">
      <aside class="t-inst" aria-label="The instrument: contents">
        <div class="t-inst-inner">
          <svg
            class="instrument"
            viewBox={INSTRUMENT_VIEWBOX}
            role="group"
            aria-label="Astrolabe for the latitude of Oxford. The outer ring lists the sections; the rule turns to the one you are reading."
            set:html={front}
          />
          <div class="knob-set" aria-hidden="false">
            <label for="t-view-me" class="k-lab k-me">Middel Englissh</label>
            <label for="t-view-both" class="k-lab k-both">Bothe</label>
            <label for="t-view-modern" class="k-lab k-mod">Modern</label>
            <button type="button" class="knob" aria-label="Turn to the next text">
              <span class="knob-ind"></span>
            </button>
          </div>
        </div>
      </aside>

      <div class="t-text">
        <header class="plate t-title">
          <p class="t-kicker">Geoffrey Chaucer · c. 1391</p>
          <h1>
            <span class="t-me-title" lang="enm">Tretis of the Astrolabie</span>
            <span class="t-en-title">A Treatise on the Astrolabe</span>
          </h1>
          <div class="scale" aria-hidden="true"></div>
          <p class="t-intro">
            Written for “litell Lowis my sone,” and for an instrument
            <span lang="enm">“compowned after the latitude of Oxenford.”</span>
            The instrument beside this text is drawn for that latitude.
          </p>
          <p class="t-credit">
            Middle English text: W. W. Skeat (1894).{usesPrivate && (
              <>
                <br />Modern English: {PRIVATE_MODERN.credit}.
                <strong class="t-private">Draft preview; publication permission pending.</strong>
              </>
            )}
          </p>
        </header>

        <nav class="arcbar" aria-label="Contents">
          <svg class="arcbar-svg" viewBox="0 0 360 66" preserveAspectRatio="xMidYMin meet" aria-hidden="false">
            <path d={arcPath(ARC.r)} class="ab-line" />
            <path d={arcPath(ARC.r - 9)} class="ab-line ab-faint" />
            <path d={arcTicks} class="ab-tick" />
            {sections.map((s, i) => {
              const a = mStation(i);
              const [x, y] = arcPt(ARC.r - 15, a);
              const [hx, hy] = arcPt(ARC.r - 6, a);
              return (
                <a href={`#${s.id}`} class="ab-st" data-station={s.id} aria-label={caption[s.id]}>
                  <circle cx={hx.toFixed(1)} cy={hy.toFixed(1)} r="14" class="ab-hit" />
                  <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.6" class="ab-dot" />
                  <text
                    class="ab-num"
                    transform={`translate(${arcPt(ARC.r - 26, a).map((v) => v.toFixed(1)).join(" ")}) rotate(${a.toFixed(2)})`}
                  >
                    {s.entry.data.part === "Prologue" ? "P" : `${partRoman[s.entry.data.part]}·${s.entry.data.section}`}
                  </text>
                </a>
              );
            })}
            <g class="ab-rule" id="ab-rule" style={`transform-origin: ${ARC.cx}px ${ARC.cy}px`}>
              <path d={`M${ARC.cx} ${ARC.cy - ARC.r - 1} l 4.5 9 l -1.6 0 l 0 7 l -5.8 0 l 0 -7 l -1.6 0 z`} class="ab-pointer" />
            </g>
          </svg>
          <div class="arcbar-row">
            <span class="ab-now" id="ab-now">{caption[sections[0]?.id] ?? ""}</span>
            <span class="ab-switch">
              <label for="t-view-me">ME</label><label for="t-view-both">Bothe</label><label for="t-view-modern">Modern</label>
            </span>
          </div>
        </nav>

        {
          parts.map((p) => (
            <section class="t-part" aria-label={p.name}>
              {p.name !== "Prologue" && (
                <header class="plate t-part-head">
                  <div class="t-part-words">
                    <p class="t-kicker">{partLatin[p.name]}</p>
                    <h2>{p.name}</h2>
                    <p class="t-part-rubric" lang="enm">{partRubric[p.name]}</p>
                  </div>
                  <div class="t-part-fig" aria-hidden={p.name === "Part II" ? "true" : undefined}>
                    {p.name === "Part I" ? (
                      <Exploded />
                    ) : (
                      <svg viewBox="-104 -104 208 208" class="backface" set:html={back} />
                    )}
                  </div>
                </header>
              )}
              {p.items.map(({ entry, Content, id, privateModern }) => {
                const [mp, ms] = medal(entry.data.part, entry.data.section);
                const heading =
                  entry.data.heading && entry.data.part !== "Prologue"
                    ? entry.data.heading
                    : null;
                return (
                  <article class="plate t-sec" id={id}>
                    <header class="t-sec-head">
                      <div class="medal" aria-hidden="true">
                        <svg viewBox="-30 -30 60 60">
                          <circle r="28" class="md-face" />
                          <circle r="23" class="md-line" />
                          {Array.from({ length: 60 }, (_, k) => (
                            <line
                              y1="-28"
                              y2={k % 5 === 0 ? "-23" : "-25.5"}
                              transform={`rotate(${k * 6})`}
                              class="md-line"
                            />
                          ))}
                          {mp && (
                            <text y="-7" class="md-part">
                              {mp}
                            </text>
                          )}
                          <text y={mp ? "13" : "8"} class={mp ? "md-num" : "md-num md-p"}>
                            {ms}
                          </text>
                        </svg>
                      </div>
                      <div class="t-sec-words">
                        <p class="t-kicker">
                          {partLatin[entry.data.part]}
                          {entry.data.part !== "Prologue" && ` · § ${entry.data.section}`}
                        </p>
                        <h3 lang={heading ? "enm" : undefined}>
                          {heading ?? plainCaption[id] ?? `§ ${entry.data.section}`}
                        </h3>
                        {entry.data.latin && (
                          <p class="t-latin" lang="la">
                            {entry.data.latin}
                          </p>
                        )}
                      </div>
                    </header>
                    <div class="scale" aria-hidden="true" />
                    <div class="faces">
                      {entry.data.scene && (
                        <div class="t-scene">
                          <Scene
                            name={entry.data.scene}
                            label={`Figure for ${entry.data.part}${entry.data.part === "Prologue" ? "" : ` § ${entry.data.section}`}`}
                          />
                        </div>
                      )}
                      <div class="t-me" lang="enm">
                        <Content />
                      </div>
                      <div class="face-rule" aria-hidden="true">
                        <span>Modern English</span>
                      </div>
                      <div class="t-modern">
                        {privateModern ? (
                          privateModern.map((para) => <p>{para}</p>)
                        ) : entry.data.modern ? (
                          <p>{entry.data.modern}</p>
                        ) : (
                          <p class="t-pending">Modern rendering — pending</p>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </section>
          ))
        }

        <footer class="plate t-colophon">
          <p class="t-kicker">Colophon</p>
          <p>
            Every line of the instrument is computed: almucantars every five
            degrees and azimuths every fifteen, by stereographic projection for
            Oxford at 51° 50′ north; the rete carries sixteen stars set by their
            right ascension and declination.
          </p>
        </footer>
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: "Junicode 2";
    src: url("/fonts/treatise/junicode/Junicode2-Roman.woff2") format("woff2");
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Texturina";
    src: url("/fonts/treatise/texturina/Texturina-VF.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "EB Garamond";
    src: url("/fonts/treatise/ebgaramond/EBGaramond-VF.woff2") format("woff2");
    font-weight: 400 800;
    font-style: normal;
    font-display: swap;
  }

  /* The whole page sits in the instrument's case: dark bronze. Scoped to
     this page with :has(). */
  body:has(.treatise) {
    --theme-background: #120e09;
    --theme-text: #e8dcc0;
    --header-color: #d4ad62;
    --text-hover: #f1d898;
    --tag-border: #6b5230;
    --footer-label: #d4ad62;
    --footer-link: #e8dcc0;
    --footer-stroke: #3a2c1b;
    --footer-gradient: linear-gradient(to bottom, #120e09, #1c150d);
    background:
      radial-gradient(ellipse 80% 60% at 28% 18%, #2b2116 0%, transparent 70%),
      radial-gradient(ellipse 60% 50% at 90% 90%, #1f170e 0%, transparent 70%),
      #120e09;
    background-size: auto;
    animation: none;
    overflow-x: clip;
  }
  body:has(.treatise) #decor-footer {
    display: none;
  }
  html:has(.treatise) {
    background: #120e09;
  }
  @media (prefers-reduced-motion: no-preference) {
    html:has(.treatise) {
      scroll-behavior: smooth;
    }
  }
  main:has(> .treatise) {
    max-width: 1400px;
  }
  @media (min-width: 1000px) {
    .page-padding:has(.treatise) {
      padding-left: 40px;
      padding-right: 40px;
    }
  }
</style>

<style>
  .treatise {
    --ground: #120e09;
    --bronze: #241b12;
    --brass: #d4ad62;
    --brass-hi: #f1d898;
    --brass-lo: #8c6428;
    --hair: rgba(212, 173, 98, 0.42);
    --ink: #eadcb6;
    --ink-modern: #d6cab0;
    --enamel: #d9573c;
    --me-font: "Junicode 2", "Junicode", Georgia, serif;
    --black-font: "Texturina", var(--me-font);
    --modern-font: "EB Garamond", Georgia, serif;
    --caps-font: "EB Garamond", Georgia, serif;
    position: relative;
    z-index: 1;
    color: var(--ink);
  }

  /* ---- view radios (driven by labels on the instrument) ---- */
  .t-view {
    border: 0;
    margin: 0;
    padding: 0;
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  /* ---- layout ---- */
  .t-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1000px) {
    .t-layout {
      grid-template-columns: minmax(440px, 1fr) minmax(0, 700px);
      column-gap: 40px;
    }
    .t-inst {
      position: sticky;
      top: 0;
      height: 100vh;
      align-self: start;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding-top: clamp(16px, calc(50vh - 400px), 110px);
      box-sizing: border-box;
    }
    .arcbar {
      display: none;
    }
  }
  .t-inst-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
  }
  .instrument {
    display: block;
    width: min(100%, calc((100vh - 150px) * 0.905));
    height: auto;
    overflow: visible;
  }

  /* ---- instrument styling (markup comes from set:html) ---- */
  .instrument :global(.m-toc) {
    fill: url(#inst-bronze);
    stroke: #5a4326;
    stroke-width: 1;
  }
  .instrument :global(.g-line) {
    fill: none;
    stroke: var(--hair);
    stroke-width: 0.7;
  }
  .instrument :global(.g-tick) {
    stroke-width: 0.6;
  }
  .instrument :global(.m-limb),
  .instrument :global(.m-throne) {
    fill: url(#inst-brass);
    stroke: #4a3212;
    stroke-width: 1;
  }
  .instrument :global(.t-ring) {
    fill: none;
    stroke: url(#inst-brass);
    stroke-width: 8;
  }
  .instrument :global(.t-ring-in) {
    fill: none;
    stroke: #4a3212;
    stroke-width: 0.8;
  }
  .instrument :global(.m-plate) {
    fill: url(#inst-plate-g);
  }
  .instrument :global(.e-line) {
    fill: none;
    stroke: #3a2710;
    stroke-width: 0.7;
  }
  .instrument :global(.e-strong) {
    stroke-width: 1.3;
  }
  .instrument :global(.e-faint) {
    stroke-width: 0.45;
    opacity: 0.8;
  }
  .instrument :global(.e-dash) {
    stroke-dasharray: 2 3;
    stroke-width: 0.6;
  }
  .instrument :global(.e-tick) {
    stroke-width: 0.6;
  }
  .instrument :global(.e-dot) {
    fill: #3a2710;
  }
  .instrument :global(.e-num) {
    font-family: var(--caps-font);
    font-size: 8.5px;
    font-weight: 600;
    fill: #3a2710;
    text-anchor: middle;
    dominant-baseline: middle;
    font-variant-numeric: lining-nums;
  }
  .instrument :global(.e-inscr) {
    font-family: var(--caps-font);
    font-size: 8px;
    letter-spacing: 0.22em;
    fill: #4a3212;
    font-weight: 600;
  }
  .instrument :global(.e-small) {
    font-size: 6.5px;
    letter-spacing: 0.18em;
  }
  .instrument :global(.r-metal) {
    fill: url(#inst-rete-g);
    stroke: #4a3010;
    stroke-width: 0.7;
  }
  .instrument :global(.r-wire) {
    fill: none;
    stroke: url(#inst-rete-g);
    stroke-width: 3;
  }
  .instrument :global(.r-strut) {
    fill: none;
    stroke: #d9ab55;
    stroke-width: 2.6;
    stroke-linecap: round;
  }
  .instrument :global(.r-hole) {
    fill: #3a2710;
  }
  .instrument :global(.r-engr) {
    fill: none;
    stroke: #4a3010;
    stroke-width: 0.6;
  }
  .instrument :global(.r-fine) {
    stroke-width: 0.35;
  }
  .instrument :global(.r-sign) {
    font-family: var(--caps-font);
    font-size: 5.4px;
    letter-spacing: 0.16em;
    fill: #4a3010;
    font-weight: 600;
    dominant-baseline: middle;
  }
  .instrument :global(.r-name) {
    font-family: var(--caps-font);
    font-size: 5.2px;
    letter-spacing: 0.12em;
    fill: #2e1e0a;
    font-weight: 600;
    dominant-baseline: middle;
  }
  .instrument :global(.u-metal) {
    fill: url(#inst-rule-g);
    stroke: #f0d48d;
    stroke-width: 0.6;
  }
  .instrument :global(.u-fid) {
    stroke: #f3dc9e;
    stroke-width: 0.5;
  }
  .instrument :global(.u-boss) {
    fill: url(#inst-brass);
    stroke: #3a2710;
    stroke-width: 0.8;
  }
  .instrument :global(.u-pin) {
    fill: #3a2710;
  }
  .instrument :global(.station) {
    cursor: pointer;
    outline: none;
  }
  .instrument :global(.station-hit) {
    fill: none;
    stroke: transparent;
    stroke-width: 36;
    pointer-events: stroke;
  }
  .instrument :global(.station-text) {
    font-family: var(--caps-font);
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.14em;
    fill: #b39867;
    transition: fill 0.3s;
  }
  .instrument :global(.station-dot) {
    fill: #6b5230;
    stroke: #b39867;
    stroke-width: 0.6;
    transition: fill 0.3s;
  }
  .instrument :global(.station:hover .station-text),
  .instrument :global(.station:focus-visible .station-text) {
    fill: var(--brass-hi);
  }
  .instrument :global(.station:focus-visible .station-hit) {
    stroke: rgba(241, 216, 152, 0.12);
  }
  .instrument :global(.station.active .station-text) {
    fill: var(--brass-hi);
    font-weight: 600;
  }
  .instrument :global(.station.active .station-dot) {
    fill: var(--enamel);
    stroke: var(--brass-hi);
  }

  /* ---- the selector knob ---- */
  .knob-set {
    position: relative;
    width: 340px;
    height: 98px;
    margin-top: 4px;
    flex: none;
  }
  .knob {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 46px;
    height: 46px;
    margin-left: -23px;
    border-radius: 50%;
    border: 1px solid #3a2710;
    padding: 0;
    cursor: pointer;
    background:
      radial-gradient(circle at 38% 32%, #f3d991 0, #c99a48 38%, #7d5520 72%, transparent 73%),
      repeating-conic-gradient(#6d4919 0 4deg, #d1a656 4deg 8deg);
    box-shadow:
      0 6px 10px -3px #000,
      0 0 0 4px #1d160e,
      0 0 0 5px var(--hair);
  }
  .knob-ind {
    position: absolute;
    left: 50%;
    top: 4px;
    width: 3px;
    height: 17px;
    margin-left: -1.5px;
    background: #2e1e0a;
    border-radius: 2px;
    transform-origin: 50% 19px;
    transform: rotate(0deg);
    transition: transform 0.35s cubic-bezier(0.3, 1.5, 0.5, 1);
  }
  .treatise:has(#t-view-me:checked) .knob-ind {
    transform: rotate(-55deg);
  }
