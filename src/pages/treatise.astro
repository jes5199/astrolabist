<script>
  import { initSky } from "../scripts/treatise-sky";

  const root = document.querySelector<HTMLElement>(".treatise");
  if (root) {
    initSky(root);

    // --- Glosses ---------------------------------------------------------
    // Every glossed word is a span[role=button] with data-g (its entry) and
    // aria-describedby (a hidden description, for screen readers). One shared
    // popover shows the gloss: on hover (mouse), on tap (touch: tap again or tap
    // elsewhere to close), and on keyboard focus (Enter toggles, Escape closes).
    type GD = { g: string; d: string | null; s: string; ds: string | null; k: "def" | "note" | "intro" | null; o: 0 | 1 };
    const GLOSS: Record<string, GD> = JSON.parse(document.getElementById("gl-data")?.textContent || "{}");
    const pop = document.getElementById("gl-pop") as HTMLElement | null;
    const words = [...root.querySelectorAll<HTMLElement>(".gw")];
    // Mark the words the section's own figure shows.
    root.querySelectorAll<HTMLElement>(".t-sec[data-figure-terms]").forEach((sec) => {
      const terms = new Set((sec.dataset.figureTerms ?? "").split(" "));
      sec.querySelectorAll<HTMLElement>(".gw").forEach((w) => {
        if (terms.has(w.dataset.g ?? "")) w.dataset.fig = "";
      });
    });
    let open: HTMLElement | null = null;
    let pinned = false;
    let hideT = 0;
    let lit: HTMLElement | null = null;
    const figureOf = (w: HTMLElement) => {
      if (!("fig" in w.dataset)) return null;
      // An inline window inside the same paragraph run wins (the sword), else the section's own.
      const sec = w.closest(".t-sec");
      const inl = w.dataset.g && ["swerd", "sleen", "envye"].includes(w.dataset.g) ? sec?.querySelector<HTMLElement>(".inline-win .win") : null;
      return inl ?? sec?.querySelector<HTMLElement>(".t-aside .win") ?? null;
    };
    const place = () => {
      if (!pop || !open) return;
      const r = open.getClientRects()[0] ?? open.getBoundingClientRect();
      const vw = document.documentElement.clientWidth;
      const vh = window.innerHeight;
      const m = 10;
      pop.style.left = "0px";
      pop.style.top = "0px";
      const pw = pop.offsetWidth;
      const ph = pop.offsetHeight;
      const cx = r.left + r.width / 2;
      const left = Math.max(m, Math.min(vw - pw - m, cx - pw / 2));
      const below = r.bottom + 12;
      const above = r.top - 12 - ph;
      // Prefer below; flip above when it would run off the bottom and there is room above.
      const useAbove = below + ph > vh - m && above >= m;
      const top = useAbove ? above : Math.min(below, Math.max(m, vh - ph - m));
      pop.dataset.place = useAbove ? "above" : "below";
      pop.style.left = `${Math.round(left)}px`;
      pop.style.top = `${Math.round(top)}px`;
      pop.style.setProperty("--ax", `${Math.round(Math.max(14, Math.min(pw - 14, cx - left)))}px`);
    };
    const close = () => {
      window.clearTimeout(hideT);
      if (open) open.setAttribute("aria-expanded", "false");
      lit?.classList.remove("lit");
      lit = null;
      open = null;
      pinned = false;
      if (pop) pop.hidden = true;
    };
    const show = (w: HTMLElement, pin = false) => {
      window.clearTimeout(hideT);
      const d = GLOSS[w.dataset.g ?? ""];
      if (!pop || !d) return;
      if (open && open !== w) open.setAttribute("aria-expanded", "false");
      open = w;
      pinned = pin;
      w.setAttribute("aria-expanded", "true");
      const q = (c: string) => pop.querySelector<HTMLElement>(c)!;
      q(".gp-w").textContent = w.dataset.w ?? w.textContent ?? "";
      q(".gp-g").textContent = d.g;
      // Glossary definitions read as definitions; Skeat's notes and introduction are labelled as such.
      const kind = d.k ?? "def";
      const dp = q(".gp-d");
      dp.hidden = !d.d;
      dp.dataset.kind = kind;
      q(".gp-dl").textContent = kind === "note" ? "Skeat's note" : kind === "intro" ? "From Skeat's introduction" : "";
      q(".gp-dt").textContent = d.d ?? "";
      q(".gp-s1").textContent = d.s;
      const lab = kind === "note" ? "Note" : kind === "intro" ? "Introduction" : "Definition";
      q(".gp-s2").textContent = d.ds ? `${lab}: ${d.ds}` : "";
      if (d.o) pop.dataset.ours = "";
      else delete pop.dataset.ours;
      const fig = figureOf(w);
      if (fig) pop.dataset.fig = "";
      else delete pop.dataset.fig;
      if (lit !== fig) {
        lit?.classList.remove("lit");
        fig?.classList.add("lit");
        lit = fig;
      }
      pop.hidden = false;
      place();
    };
    const later = () => {
      window.clearTimeout(hideT);
      hideT = window.setTimeout(() => {
        if (!pinned) close();
      }, 180);
    };
    // Was this word's gloss already open (and pinned, or opened by touch) when the press began?
    // Focus opens a gloss on press, so the click that follows must not read it as a second tap.
    let pressWasOpen: boolean | null = null;
    for (const w of words) {
      w.addEventListener("pointerenter", (e) => {
        if (e.pointerType === "mouse") show(w, pinned && open === w);
      });
      w.addEventListener("pointerleave", (e) => {
        if (e.pointerType === "mouse" && !pinned) later();
      });
      w.addEventListener("pointerdown", (e) => {
        pressWasOpen = open === w && (pinned || e.pointerType !== "mouse");
      });
      w.addEventListener("click", (e) => {
        e.preventDefault();
        // Touch / pen: a tap toggles. Mouse: a click pins the gloss open (or closes a pinned one).
        const was = pressWasOpen ?? (open === w && pinned);
        pressWasOpen = null;
        if (was) close();
        else show(w, true);
      });
      w.addEventListener("focus", () => {
        if (open !== w) show(w, false);
      });
      w.addEventListener("blur", () => {
        if (!pinned) later();
      });
      w.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          if (open === w && pinned) close();
          else show(w, true);
        } else if (e.key === "Escape" && open) {
          e.preventDefault();
          close();
        }
      });
    }
    pop?.addEventListener("pointerenter", () => window.clearTimeout(hideT));
    pop?.addEventListener("pointerleave", (e) => {
      if (e.pointerType === "mouse" && !pinned) later();
    });
    document.addEventListener("pointerdown", (e) => {
      const t = e.target as Node;
      if (open && !open.contains(t) && !pop?.contains(t)) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && open) close();
    });
    let raf = 0;
    const follow = () => {
      if (!open) return;
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        if (!open) return;
        const r = open.getBoundingClientRect();
        // Scrolled well away: let it go.
        if (r.bottom < -40 || r.top > window.innerHeight + 40) close();
        else place();
      });
    };
    window.addEventListener("scroll", follow, { passive: true });
    window.addEventListener("resize", follow);

    // Each section's paragraphs become a constellation strung down the left margin.
    const SVGNS = "http://www.w3.org/2000/svg";
    const drawConst = (body: HTMLElement) => {
      const svg = body.querySelector<SVGSVGElement>(".t-const");
      if (!svg) return;
      svg.replaceChildren();
      const box = body.getBoundingClientRect();
      if (!box.width) return;
      const pts: { x: number; y: number; first: boolean }[] = [];
      const ps = [...body.querySelectorAll<HTMLElement>(".t-me > p")];
      ps.forEach((p, i) => {
        const r = p.getBoundingClientRect();
        const lh = parseFloat(getComputedStyle(p).lineHeight) || 24;
        pts.push({ x: i % 2 ? 11 : 4, y: r.top - box.top + Math.min(lh, 40) * 0.55, first: i === 0 });
      });
      if (!pts.length) return;
      const path = document.createElementNS(SVGNS, "path");
      path.setAttribute("d", pts.map((p, i) => `${i ? "L" : "M"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join(""));
      svg.appendChild(path);
      for (const p of pts) {
        const r = p.first ? 2.8 : 1.7;
        const g = document.createElementNS(SVGNS, "circle");
        g.setAttribute("class", "c-glow");
        g.setAttribute("cx", p.x.toFixed(1));
        g.setAttribute("cy", p.y.toFixed(1));
        g.setAttribute("r", String(r * 3));
        svg.appendChild(g);
        const c = document.createElementNS(SVGNS, "circle");
        c.setAttribute("class", "c-star gold");
        c.setAttribute("cx", p.x.toFixed(1));
        c.setAttribute("cy", p.y.toFixed(1));
        c.setAttribute("r", String(r));
        svg.appendChild(c);
      }
    };
    const bodies = [...root.querySelectorAll<HTMLElement>(".t-body")];
    const ro = new ResizeObserver((es) => es.forEach((e) => drawConst(e.target as HTMLElement)));
    bodies.forEach((b) => ro.observe(b));
    document.fonts?.ready.then(() => bodies.forEach(drawConst));

    // Star lines under each part heading: join the stars with a faint dotted
    // line, and show the title of the star under the pointer / keyboard focus
    // (or else of the section being read) in the caption under the line.
    // A tap goes straight to the section.
    const drawBand = (band: HTMLElement) => {
      const svg = band.querySelector<SVGSVGElement>(".ts-lines");
      if (!svg) return;
      const box = band.getBoundingClientRect();
      const pts = [...band.querySelectorAll<HTMLElement>(".ts-star")].map((st) => {
        const r = st.getBoundingClientRect();
        return [r.left + r.width / 2 - box.left, r.top + r.height / 2 - box.top];
      });
      const path = document.createElementNS(SVGNS, "path");
      // A new row starts a new stroke, so no line runs back across the band.
      path.setAttribute(
        "d",
        pts.map(([x, y], i) => `${i && x > pts[i - 1][0] ? "L" : "M"}${x.toFixed(1)} ${y.toFixed(1)}`).join("")
      );
      svg.replaceChildren(path);
    };
    const bands = [...root.querySelectorAll<HTMLElement>(".ts-band")];
    const bandRO = new ResizeObserver((es) => es.forEach((e) => drawBand(e.target as HTMLElement)));
    bands.forEach((b) => bandRO.observe(b));
    document.fonts?.ready.then(() => bands.forEach(drawBand));

    type Line = { cap: HTMLElement | null; pointed: HTMLElement | null; reading: HTMLElement | null };
    const lines = new Map<HTMLElement, Line>();
    const showCaption = (nav: HTMLElement) => {
      const l = lines.get(nav);
      const a = l?.pointed ?? l?.reading;
      if (!l?.cap) return;
      l.cap.textContent = a ? a.getAttribute("aria-label") ?? "" : "";
      l.cap.classList.toggle("on", !!a);
    };
    root.querySelectorAll<HTMLElement>(".t-stars").forEach((nav) => {
      lines.set(nav, { cap: nav.querySelector(".ts-cap"), pointed: null, reading: null });
      nav.querySelectorAll<HTMLElement>("a").forEach((a) => {
        const on = () => {
          lines.get(nav)!.pointed = a;
          showCaption(nav);
        };
        const off = () => {
          const l = lines.get(nav)!;
          if (l.pointed === a) {
            l.pointed = null;
            showCaption(nav);
          }
        };
        a.addEventListener("pointerenter", on);
        a.addEventListener("focus", on);
        a.addEventListener("pointerleave", off);
        a.addEventListener("blur", off);
      });
    });

    // Mark the section in view as active (window glow + its star).
    const links = new Map<string, HTMLElement>();
    root.querySelectorAll<HTMLElement>(".t-stars [data-toc]").forEach((a) => links.set(a.dataset.toc!, a));
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          e.target.classList.toggle("active", e.isIntersecting);
          const link = links.get(e.target.id);
          link?.classList.toggle("active", e.isIntersecting);
          const nav = link?.closest<HTMLElement>(".t-stars");
          if (e.isIntersecting && link && nav) {
            lines.get(nav)!.reading = link;
            showCaption(nav);
          }
        }
      },
      { rootMargin: "-35% 0px -45% 0px" }
    );
    root.querySelectorAll(".t-sec").forEach((s) => io.observe(s));
  }
</script>
