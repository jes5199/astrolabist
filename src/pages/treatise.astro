  /* The sky itself recedes behind text: see the veils in treatise-sky.ts. */
  .t-const {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .t-const :global(path) {
    fill: none;
