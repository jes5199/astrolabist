    }
    .t-me {
      font-size: 1.12rem;
    }
    .t-me.big .init {
      --n: 3;
    }
    .t-gloss {
      margin-top: 1rem;
      padding: 0.7rem 0.8rem 0.8rem 0.9rem;
      font-size: 1.06rem;
      border-left: 3px double var(--red);
      background: rgba(150, 100, 40, 0.07);
