  .t-sec[data-glossed] .t-me :global(rt) {
    font-family: var(--modern-font);
    font-size: 0.64em;
    line-height: 1.1;
    letter-spacing: 0.01em;
    padding-top: 0.12em;
    color: #f0d48e;
    -webkit-user-select: none;
    user-select: none;
