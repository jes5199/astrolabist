<script>
  const root = document.querySelector<HTMLElement>(".treatise");
  if (root) {
    // ---- text shown: remembered per viewer ----
    const KEY = "treatise-view";
    const VIEWS = ["me", "both", "modern"];
    const radios = root.querySelectorAll<HTMLInputElement>('input[name="t-view"]');
    const apply = (v: string) => {
      if (!VIEWS.includes(v)) return;
      root.dataset.view = v;
      radios.forEach((r) => (r.checked = r.value === v));
    };
    try {
      const saved = localStorage.getItem(KEY);
      if (saved) apply(saved);
    } catch {
      /* storage unavailable */
    }
    const save = (v: string) => {
      try {
        localStorage.setItem(KEY, v);
      } catch {
        /* storage unavailable */
      }
    };
    radios.forEach((r) =>
      r.addEventListener("change", () => {
        apply(r.value);
        save(r.value);
      })
    );
    root.querySelector(".knob")?.addEventListener("click", () => {
      const next = VIEWS[(VIEWS.indexOf(root.dataset.view || "both") + 1) % VIEWS.length];
      apply(next);
      save(next);
    });

    // ---- the rule follows the reader ----
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const secs = Array.from(root.querySelectorAll<HTMLElement>(".t-sec"));
    const n = secs.length;
    const a0 = Number(root.dataset.a0);
    const a1 = Number(root.dataset.a1);
    const step = n > 1 ? (a1 - a0) / (n - 1) : 0;
    const span = Number(root.dataset.arcSpan);
    const rule = root.querySelector<SVGGElement>("#inst-rule");
    const rete = root.querySelector<SVGGElement>("#inst-rete");
    const abRule = root.querySelector<SVGGElement>("#ab-rule");
    const abNow = root.querySelector<HTMLElement>("#ab-now");
    const stationsById = new Map<string, Element[]>();
    root.querySelectorAll("[data-station]").forEach((el) => {
      const id = (el as HTMLElement).dataset.station!;
      stationsById.set(id, [...(stationsById.get(id) || []), el]);
    });
    const captions = new Map<string, string>();
    root.querySelectorAll<HTMLElement>(".ab-st").forEach((a) =>
      captions.set(a.dataset.station!, a.getAttribute("aria-label") || "")
    );

    let current = 0;
    let target = 0;
    let raf = 0;
    let activeId = "";
    let sky = 0;
    let skyNow = 0;
    const ease = (t: number) => t * t * (3 - 2 * t);

    const measure = () => {
      if (!n) return;
      const line = window.innerHeight * 0.35;
      let idx = -1;
      let p = 0;
      for (let i = 0; i < n; i++) {
        const r = secs[i].getBoundingClientRect();
        if (r.height === 0) continue;
        if (r.top <= line) {
          idx = i;
          p = Math.min(1, Math.max(0, (line - r.top) / Math.max(1, r.height)));
        }
      }
      if (idx < 0) {
        const first = secs.find((s) => s.offsetHeight > 0) || secs[0];
        const r = first.getBoundingClientRect();
        const lead = Math.min(1, Math.max(0, 1 - (r.top - line) / (window.innerHeight * 0.8)));
        target = ease(lead) * a0;
      } else {
        // Detents: the rule rests on a section's station while it is read,
        // and swings to the next one over the last fifth of the section.
        const swing = idx < n - 1 ? ease(Math.min(1, Math.max(0, (p - 0.8) / 0.2))) : 0;
        target = a0 + (idx + swing) * step;
      }
      const doc = document.documentElement;
      sky = (window.scrollY / Math.max(1, doc.scrollHeight - window.innerHeight)) * 300;
      const id = secs[Math.max(0, idx)].id;
      if (id !== activeId) {
        stationsById.get(activeId)?.forEach((e) => e.classList.remove("active"));
        stationsById.get(id)?.forEach((e) => e.classList.add("active"));
        activeId = id;
        if (abNow) abNow.textContent = captions.get(id) || "";
      }
    };

    const draw = () => {
      rule?.setAttribute("transform", `rotate(${current.toFixed(2)})`);
      rete?.setAttribute("transform", `rotate(${skyNow.toFixed(2)})`);
      if (abRule) {
        const m = n > 1 ? -span + 1 + ((current - a0) / (a1 - a0)) * (2 * span - 2) : 0;
        const clamped = Math.max(-span + 1, Math.min(span - 1, m));
        abRule.style.transform = `rotate(${clamped.toFixed(3)}deg)`;
      }
    };

    const tick = () => {
      const d = target - current;
      current += Math.abs(d) < 0.02 ? d : d * 0.14;
      const ds = sky - skyNow;
      skyNow += Math.abs(ds) < 0.02 ? ds : ds * 0.08;
      draw();
      raf =
        Math.abs(target - current) > 0.01 || Math.abs(sky - skyNow) > 0.01
          ? requestAnimationFrame(tick)
          : 0;
    };

    const onScroll = () => {
      measure();
      if (reduce.matches) return; // static instrument; stations still light up
      if (!raf) raf = requestAnimationFrame(tick);
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    reduce.addEventListener?.("change", () => {
      if (reduce.matches) {
        current = target = skyNow = sky = 0;
        draw();
      } else onScroll();
    });
    // First frame: jump straight to the reading position.
    measure();
    if (!reduce.matches) {
      current = target;
      skyNow = sky;
      draw();
    } else {
      draw();
    }
  }
</script>
