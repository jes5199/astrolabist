  /* The popover: one shared element, placed by script. */
  .gl-pop {
    position: fixed;
    z-index: 50;
    left: 0;
    top: 0;
    width: min(21rem, calc(100vw - 24px));
    box-sizing: border-box;
    padding: 0.85rem 1rem 0.75rem;
    border-radius: 10px;
    background: #0b1030;
    border: 1px solid rgba(236, 201, 120, 0.45);
    box-shadow:
      0 14px 40px rgba(0, 0, 0, 0.6),
