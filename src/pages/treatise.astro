    font-family: var(--me-font);
    font-size: 0.82rem;
    letter-spacing: 0.36em;
    text-transform: uppercase;
    color: var(--faint);
    margin: 0 0 0.6rem;
  }
  .t-sec-label h3 {
    font-family: var(--me-font);
    font-weight: 500;
    font-size: 1.12rem;
    line-height: 1.6;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gold);
    margin: 0 0 0.75rem;
    text-shadow: 0 0 14px rgba(236, 201, 120, 0.25);
  }
  .t-sec-label h3::after {
    content: "";
    display: block;
    width: 7rem;
    height: 1px;
    margin-top: 0.9rem;
    background: linear-gradient(90deg, var(--gold), rgba(236, 201, 120, 0));
  }
  .t-sec[data-side="r"] .t-sec-label h3::after {
    margin-left: auto;
