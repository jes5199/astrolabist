---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Scene from "../components/Scene.astro";
import { SITE_TITLE } from "../consts";
import fs from "node:fs";
import path from "node:path";
import {
  GLOSS_SAMPLE,
  glossSection,
  glossEntries,
  sourceLine,
  defLine,
  type GlossStats,
} from "../lib/treatise-gloss";

// Gloss variant: Middle English only. Morrison's modern rendering is offered as a
// collapsed per-section disclosure; set this to false to remove it (and its credits).
const SHOW_MORRISON = true;

// Scene terms: glossed words that the section's own figure shows. Opening one of
// these glosses lights that figure's window.
const FIGURE_TERMS: Record<string, string[]> = {
  "00-prologue": ["swerd", "sleen", "envye"],
  "p1-01": ["thoumbe", "heighte"],
  "p1-02": ["turet", "renneth", "moder"],
  "p1-03": ["moder", "riet", "wombe", "thinne", "clymatz", "webbe", "loppe"],
};

const entries = (await getCollection("treatise")).sort(
  (a, b) => a.data.order - b.data.order
);

// Part-level rubrics from Skeat's text (see src/content/treatise/_SOURCE.md).
const partRubric: Record<string, string> = {
  "Part I": "HERE BIGINNETH THE DESCRIPCION OF THE ASTROLABIE.",
  "Part II": "HERE BIGINNEN THE CONCLUSIONS OF THE ASTROLABIE.",
};
const partLatin: Record<string, string> = {
  Prologue: "PROLOGUS",
  "Part I": "PARS PRIMA",
  "Part II": "PARS SECUNDA",
};

const partSlug: Record<string, string> = {
  "Part I": "part-1",
  "Part II": "part-2",
};
const anchor = (part: string, section: string) =>
  part === "Prologue" ? "prologue" : `${partSlug[part]}-${section}`;

// Optional modern text, read at build time from <dir>/<slug>.txt if the file exists.
// Morrison's translation is permitted on this branch only; publishing on the live site
// still needs a second permission (see src/treatise-text/morrison/README.md).
const PRIVATE_MODERN = { dir: "src/treatise-text/morrison", credit: "James E. Morrison" };
const privateModern = (slug: string): string[] | null => {
  const f = path.join(process.cwd(), PRIVATE_MODERN.dir, `${slug}.txt`);
  if (!fs.existsSync(f)) return null;
  return fs.readFileSync(f, "utf8").split(/\n\s*\n/).map((p) => p.trim()).filter(Boolean);
};

const roman = (n: number) => {
  const t: [number, string][] = [[40, "XL"], [10, "X"], [9, "IX"], [5, "V"], [4, "IV"], [1, "I"]];
  let s = "";
  for (const [v, r] of t) while (n >= v) { s += r; n -= v; }
  return s;
};
// First few words of a passage, used as a map label.
const incipit = (text: string, words = 5) =>
  text.replace(/\s+/g, " ").trim().split(" ").slice(0, words).join(" ").replace(/[,.;:]+$/, "");
const sentence = (t: string) => t.charAt(0) + t.slice(1).toLowerCase();
// Skeat's italics come through as _underscores_; for plain-text labels drop them.
const plain = (t: string) => t.replace(/_/g, "");

// Seeded scatter of stars for the sky-window backdrops (build time, static).
// Six shared star fields, each window shows one of them at its own angle.
const mulberry = (seed: number) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};
const STARFIELDS = 6;
const starfields = Array.from({ length: STARFIELDS }, (_, k) => {
  const r = mulberry((k + 1) * 7919 + 17);
  return Array.from({ length: 70 }, () => {
    const d = 98 * Math.sqrt(r());
    const a = r() * Math.PI * 2;
    const m = r();
    return { x: (d * Math.cos(a)).toFixed(1), y: (d * Math.sin(a)).toFixed(1), r: (0.3 + m * m * 0.9).toFixed(2), o: (0.25 + m * 0.6).toFixed(2) };
  });
});

// Graduated ring round each window (one shared symbol).
const ringTicks = Array.from({ length: 72 }, (_, i) => {
  const a = (i * 5 * Math.PI) / 180;
  const r2 = i % 3 === 0 ? 102 : 99;
  return `M${(94 * Math.cos(a)).toFixed(2)} ${(94 * Math.sin(a)).toFixed(2)}L${(r2 * Math.cos(a)).toFixed(2)} ${(r2 * Math.sin(a)).toFixed(2)}`;
}).join("");

// Skeat sets some sections apart; `note` carries his own label for them.
// Run in place, right after the Middle English, so the move happens before first paint:
// each inline window goes after the paragraph it belongs to.
const PLACE_INLINE = `(function (s) {
  var me = s.parentElement;
  var ps = me.querySelectorAll(":scope > p");
  me.querySelectorAll(":scope > .inline-win").forEach(function (w) {
    var p = ps[+w.dataset.after];
    if (p) p.after(w);
  });
})(document.currentScript);`;

const kindOf = (note?: string) =>
  !note ? "main" : /spurious/i.test(note) ? "spurious" : "supplementary";

const glossStats: GlossStats = { tokens: 0, glossed: 0, forms: new Set(), keys: new Set() };

const sections = await Promise.all(
  entries.map(async (entry, i) => {
    const { Content } = await entry.render();
    const { part, section } = entry.data;
    // The Prologue's "heading" just repeats its name; label it by its first words.
    const heading = part === "Prologue" ? "" : entry.data.heading;
    const m = /^(\d+)([a-z]?)$/.exec(section);
    const ring =
      part === "Prologue"
        ? "PROLOGUS · LITELL LOWIS MY SONE"
        : `${partLatin[part]} · ${part === "Part II" ? "CONCLUSIO" : "CAPITULUM"} ${m ? roman(Number(m[1])) + (m[2] ? " " + m[2] : "") : section}`;
    const kind = kindOf(entry.data.note);
    // Inline sky windows: find the paragraph of the Middle English holding the phrase.
    const paras = entry.body.split(/\n\s*\n/).map((t) => t.replace(/\s+/g, " ").trim()).filter(Boolean);
    const inline = (entry.data.inlineScenes ?? []).map((sc) => {
      const at = paras.findIndex((t) => t.includes(sc.after.replace(/\s+/g, " ")));
      if (at < 0)
        throw new Error(`treatise: inline scene "${sc.name}" in ${entry.id}: phrase "${sc.after}" not found in the Middle English`);
      return { ...sc, at, legend: sc.label.replace(/^Figure:\s*/, "").toUpperCase() };
    });
    const kicker = part === "Prologue" ? "The Prologue" : `${part} · § ${section}`;
    const label = heading
      ? sentence(plain(incipit(heading, 6)))
      : plain(incipit(entry.body, part === "Prologue" ? 4 : 5));
    // The glossed sample: Skeat's paragraphs with each glossed word made focusable.
    const glossed = GLOSS_SAMPLE.has(entry.slug) ? glossSection(entry.slug, entry.body, glossStats) : null;
    return {
      entry,
      Content,
      glossed,
      figureTerms: FIGURE_TERMS[entry.slug] ?? [],
      i,
      kind,
      kicker,
      id: anchor(part, section),
      privateModern: SHOW_MORRISON ? privateModern(entry.slug) : null,
      ring,
      title: heading || `${incipit(entry.body, part === "Prologue" ? 4 : 5)}…`,
      label,
      field: i % STARFIELDS,
      inline,
      spin: (i * 47) % 360,
    };
  })
);
const usesPrivate = sections.some((s) => s.privateModern);
const lastSample = sections.filter((s) => s.glossed).at(-1)?.entry.slug;

// Gloss data for the page script, and one hidden description per entry for
// assistive technology (each glossed word points at its entry by aria-describedby).
const usedKeys = [...glossStats.keys].sort();
const glossData = Object.fromEntries(
  usedKeys.map((k) => {
    const e = glossEntries[k];
    return [k, { g: e.gloss, d: e.def ?? null, s: sourceLine(e), ds: defLine(e), o: e.source === "ours" ? 1 : 0 }];
  })
);
const glossDesc = usedKeys.map((k) => {
  const e = glossEntries[k];
  const parts = [e.gloss, e.def, e.source === "ours" ? "Our gloss." : `Source: ${sourceLine(e)}.`].filter(Boolean);
  return { id: `gd-${k}`, text: parts.join(". ").replace(/\.\./g, ".") };
});
console.log(
  `[treatise glosses] sample: ${glossStats.tokens} word tokens, ${glossStats.glossed} glossed (${(
    (100 * glossStats.glossed) / Math.max(1, glossStats.tokens)
  ).toFixed(1)}%); ${glossStats.forms.size} distinct forms; ${usedKeys.length} entries`
);

const parts = ["Prologue", "Part I", "Part II"].map((name) => ({
  name,
  items: sections.filter((s) => s.entry.data.part === name),
}));
const partEndRubric: Record<string, string> = {
  "Part I": "HERE ENDETH THE DESCRIPCION OF THE ASTROLABIE.",
};

// Contents: one small constellation per group, stars on a gentle wave.
const tocGroups = [
  { key: "prologue", title: "Prologue", items: sections.filter((s) => s.entry.data.part === "Prologue") },
  { key: "p1", title: "Part I", sub: "The descripcioun", items: sections.filter((s) => s.entry.data.part === "Part I") },
  { key: "p2", title: "Part II", sub: "The conclusiouns", items: sections.filter((s) => s.entry.data.part === "Part II" && s.kind === "main") },
  { key: "supp", title: "Supplementary propositions", sub: "printed by Skeat after the Explicit", items: sections.filter((s) => s.kind === "supplementary") },
  { key: "spur", title: "Spurious sections", sub: "so marked by Skeat", items: sections.filter((s) => s.kind === "spurious") },
]
  .filter((g) => g.items.length)
  .map((g) => {
    const jitter = mulberry(g.key.length * 131 + g.items.length);
    // Balanced rows on wide screens: at most 20 stars to a row.
    const rows = Math.ceil(g.items.length / 20);
    return {
    ...g,
    cols: Math.ceil(g.items.length / rows),
    items: g.items.map((s, k) => ({
      ...s,
      dy: Math.round((jitter() - 0.5) * 18),
      dx: Math.round((jitter() - 0.5) * 8),
      mag: k === 0 ? 2 : 1,
      num: s.entry.data.part === "Prologue" ? "P" : s.entry.data.section,
    })),
  };
  });
const counts = {
  prologue: tocGroups.find((g) => g.key === "prologue")?.items.length ?? 0,
  p1: tocGroups.find((g) => g.key === "p1")?.items.length ?? 0,
  p2: tocGroups.find((g) => g.key === "p2")?.items.length ?? 0,
  supp: tocGroups.find((g) => g.key === "supp")?.items.length ?? 0,
  spur: tocGroups.find((g) => g.key === "spur")?.items.length ?? 0,
};
---

<BaseLayout
  title={`A Treatise on the Astrolabe - ${SITE_TITLE}`}
  description="Geoffrey Chaucer, A Treatise on the Astrolabe (c. 1391), in W. W. Skeat's Middle English text (1894)."
>
  <div class="treatise" data-gloss="hover">
    <div class="sky" aria-hidden="true">
      <canvas class="sky-rete"></canvas>
    </div>
    <div class="dusk" aria-hidden="true">
      <svg class="moon" viewBox="0 0 100 100" aria-hidden="true">
        <defs>
          <mask id="moon-cut">
            <rect width="100" height="100" fill="#fff"></rect>
            <circle cx="62" cy="42" r="30" fill="#000"></circle>
          </mask>
          <radialGradient id="moon-glow">
            <stop offset="0" stop-color="#fff6dc" stop-opacity="0.55"></stop>
            <stop offset="1" stop-color="#fff6dc" stop-opacity="0"></stop>
          </radialGradient>
        </defs>
        <circle cx="50" cy="50" r="50" fill="url(#moon-glow)"></circle>
        <circle cx="50" cy="50" r="27" fill="#fff4d6" mask="url(#moon-cut)"></circle>
      </svg>
      <span class="evening-star"></span>
    </div>
    <div class="dawn" aria-hidden="true"><span class="sun"></span></div>

    <!-- Shared drawings for the sky windows: the graduated ring and six star fields. -->
    <svg class="t-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <path id="win-arc" d="M-108 0A108 108 0 1 1 108 0A108 108 0 1 1 -108 0"></path>
        <symbol id="win-ring" viewBox="-120 -120 240 240" overflow="visible">
          <g fill="none" stroke="#ecc978">
            <circle r="117" stroke-width="1.2" opacity="0.7"></circle>
            <circle r="94" stroke-width="0.8" opacity="0.6"></circle>
            <circle r="102" stroke-width="0.5" opacity="0.5"></circle>
            <path d={ringTicks} stroke-width="0.6" opacity="0.55"></path>
          </g>
          <path d="M0 117L3 110L0 104L-3 110Z" fill="#ecc978"></path>
        </symbol>
        {starfields.map((f, k) => (
          <symbol id={`win-field-${k}`} viewBox="-100 -100 200 200">
            <g fill="#e2e8ff">
              {f.map((s) => <circle cx={s.x} cy={s.y} r={s.r} opacity={s.o}></circle>)}
            </g>
          </symbol>
        ))}
      </defs>
    </svg>

    <div class="t-inner">
      <header class="t-hero">
        <p class="t-kicker">Geoffrey Chaucer <span>✦</span> c. 1391</p>
        <h1><span class="h1-a">A Treatise</span> <span class="h1-b">on the Astrolabe</span></h1>
        <p class="t-dedication" lang="enm">“Litell Lowis my sone…”</p>
        <p class="t-intro">
          Middle English text: W. W. Skeat (1894). Glosses from Skeat's glossaries to the Treatise
          (1872) and to Chaucer (1894), for the Prologue and Part I §§ 1–3.{usesPrivate && (
            <> Modern rendering, folded under each section: {PRIVATE_MODERN.credit}. <strong class="t-private">Draft preview; publication permission pending.</strong></>
          )}
        </p>
        <p class="t-hint">Read on, and the heavens turn about the lode-sterre.</p>
      </header>

      <nav class="t-toc" id="contents" aria-label="Contents">
        <h2>The Conclusiouns, as a constellacioun</h2>
        <div class="toc-chart">
          {tocGroups.map((g) => (
            <section class={`toc-group toc-${g.key}`} aria-labelledby={`toc-h-${g.key}`}>
              <h3 id={`toc-h-${g.key}`}>
                <span class="toc-gtitle">{g.title}</span>
                {g.sub && <span class="toc-gsub">{g.sub}</span>}
              </h3>
              <div class="toc-band">
                <svg class="toc-lines" aria-hidden="true"></svg>
                <ol style={`--cols:${g.cols}`}>
                  {g.items.map((s) => (
                    <li style={`--dy:${s.dy}px;--dx:${s.dx}px`} data-mag={s.mag} data-kind={s.kind}>
                      <a href={`#${s.id}`} data-toc={s.id} aria-label={`${s.kicker}: ${s.label}`} data-caption-kicker={s.kicker} data-caption={s.label}>
                        <span class="toc-star" aria-hidden="true"></span>
                        <span class="toc-n" aria-hidden="true">{s.num}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            </section>
          ))}
        </div>
        <p class="toc-caption" aria-hidden="true">
          <span class="toc-ck">{sections[0].kicker}</span>
          <span class="toc-ct" lang="enm">{sections[0].label}…</span>
        </p>
        <details class="toc-full">
          <summary>Every section, by its first words</summary>
          <div class="toc-cols">
            {tocGroups.map((g) => (
              <div class="toc-list">
                <h3>{g.title}</h3>
                <ol>
                  {g.items.map((s) => (
                    <li>
                      <a href={`#${s.id}`}>
                        <span class="tl-n">{s.entry.data.part === "Prologue" ? "" : `§ ${s.entry.data.section}`}</span>
                        <span class="tl-t" lang="enm">{s.label}…</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </details>
      </nav>

      <div class="gl-bar" role="group" aria-label="Glosses">
        <span class="gl-hint"><span class="gl-hint-wide">Hover or tap a</span><span class="gl-hint-narrow">Tap a</span> <span class="gl-cue">marked word</span><span class="gl-hint-wide"> for its gloss</span></span>
        <button type="button" class="gl-all" aria-pressed="false"><span class="gl-hint-wide">Show&nbsp;</span>all glosses</button>
      </div>

      <div class="gl-descs" hidden>
        {glossDesc.map((d) => <span id={d.id}>{d.text}</span>)}
      </div>
      <script type="application/json" id="gl-data" set:html={JSON.stringify(glossData).replace(/</g, "\\u003c")}></script>
      <div class="gl-pop" id="gl-pop" role="tooltip" hidden>
        <p class="gp-w" lang="enm"></p>
        <p class="gp-g"></p>
        <p class="gp-d"></p>
        <p class="gp-fig">Shown in the figure</p>
        <p class="gp-s"><span class="gp-s1"></span><span class="gp-s2"></span></p>
      </div>

      {
        parts.map((p) => (
          <section class="t-part" aria-label={p.name}>
            {p.name !== "Prologue" && (
              <header class="t-part-head">
                <svg class="part-rose" viewBox="-50 -50 100 100" aria-hidden="true">
                  <g fill="none" stroke="currentColor" stroke-width="0.5">
                    <circle r="46"></circle>
                    <circle r="30" stroke-dasharray="1 2"></circle>
                  </g>
                  <path d="M0-48L5-5L48 0L5 5L0 48L-5 5L-48 0L-5-5Z" fill="currentColor" opacity="0.85"></path>
                  <path d="M0-30L3-3L30 0L3 3L0 30L-3 3L-30 0L-3-3Z" fill="currentColor" opacity="0.5" transform="rotate(45)"></path>
                </svg>
                <p class="t-part-latin">{partLatin[p.name]}</p>
                <h2>{p.name}</h2>
                <p class="t-part-rubric" lang="enm">{partRubric[p.name]}</p>
              </header>
            )}
            {p.items.map(({ entry, Content, glossed, figureTerms, id, privateModern, ring, title, field, spin, i, kind, kicker, inline }, k) => (
              <>
                {kind !== "main" && p.items[k - 1]?.kind !== kind && (
                  <header class={`t-group-head t-group-${kind}`}>
                    <p lang="enm">{plain(entry.data.note ?? "")}</p>
                  </header>
                )}
                <article
                  class="t-sec"
                  id={id}
                  data-side={i % 2 ? "r" : "l"}
                  data-kind={kind}
                  data-glossed={glossed ? "" : undefined}
                  data-figure-terms={figureTerms.length ? figureTerms.join(" ") : undefined}
                >
                  <div class="t-aside">
                    <div class="win">
                      <svg class="win-ring" viewBox="-120 -120 240 240" aria-hidden="true">
                        <use href="#win-ring" x="-120" y="-120" width="240" height="240"></use>
                        <text class="ring-text">
                          <textPath href="#win-arc" startOffset="25%" text-anchor="middle">{ring}</textPath>
                        </text>
                      </svg>
                      <div class="win-glass">
                        <svg class="win-stars" viewBox="-100 -100 200 200" aria-hidden="true">
                          <use href={`#win-field-${field}`} x="-100" y="-100" width="200" height="200" transform={`rotate(${spin})`}></use>
                        </svg>
                        <Scene
                          name={entry.data.scene ?? "night-window"}
                          label={`Figure for ${entry.data.part}${entry.data.part === "Prologue" ? "" : ` § ${entry.data.section}`}`}
                        />
                      </div>
                    </div>
                  </div>
                  <div class="t-main">
                    <header class="t-sec-label">
                      <p class="t-sec-kicker">
                        {entry.data.part === "Prologue" ? kicker : <>{entry.data.part} · § <span class="t-num">{entry.data.section}</span></>}
                        {kind !== "main" && <span class="t-sec-kind"> · {kind}</span>}
                      </p>
                      <h3 lang="enm">
                        <span class="t-sec-title">{title}</span>
                      </h3>
                      {entry.data.latin && (
                        <p class="t-latin" lang="la">
                          {entry.data.latin}
                        </p>
                      )}
                    </header>
                    <div class="t-body">
                      <div class="t-me" lang="enm">
                        {glossed ? glossed.map((h) => <p set:html={h} />) : <Content />}
                        {inline.map((sc, j) => (
                          <div class="inline-win" data-after={sc.at}>
                            <div class="win">
                              <svg class="win-ring" viewBox="-120 -120 240 240" aria-hidden="true">
                                <use href="#win-ring" x="-120" y="-120" width="240" height="240"></use>
                                <text class="ring-text">
                                  <textPath href="#win-arc" startOffset="25%" text-anchor="middle">{sc.legend}</textPath>
                                </text>
                              </svg>
                              <div class="win-glass win-glass-full">
                                <svg class="win-stars" viewBox="-100 -100 200 200" aria-hidden="true">
                                  <use href={`#win-field-${(field + j + 1) % 6}`} x="-100" y="-100" width="200" height="200"></use>
                                </svg>
                                <Scene name={sc.name} label={sc.label} />
                              </div>
                            </div>
                          </div>
                        ))}
                        {inline.length > 0 && (
                          <script is:inline set:html={PLACE_INLINE}></script>
                        )}
                      </div>
                      {privateModern && (
                        <details class="t-morrison">
                          <summary>Modern rendering (Morrison)</summary>
                          <div class="tm-body">
                            <p class="tm-credit">
                              {PRIVATE_MODERN.credit}. <strong class="t-private">Draft preview; publication permission pending.</strong>
                            </p>
                            {privateModern.map((p) => <p>{p}</p>)}
                          </div>
                        </details>
                      )}
                      <svg class="t-const" aria-hidden="true"></svg>
                    </div>
                  </div>
                </article>
                {entry.data.colophon && (
                  <p class="t-colophon" lang="la">{entry.data.colophon}</p>
                )}
                {entry.slug === lastSample && (
                  <aside class="t-sample-end" aria-label="End of the glossed sample">
                    <p>The glossed sample ends here.</p>
                    <p>From § 4 on, Skeat's text is shown without glosses.</p>
                  </aside>
                )}
              </>
            ))}
            {partEndRubric[p.name] && (
              <p class="t-part-end" lang="enm">{partEndRubric[p.name]}</p>
            )}
          </section>
        ))
      }

      <footer class="t-end">
        <p class="t-explicit">Explicit</p>
        <p class="t-credit">
          Middle English: W. W. Skeat (1894). Glosses: W. W. Skeat, Early English Text Society (1872) and
          Oxford Chaucer (1894), except those marked as ours.{usesPrivate && (
            <> Modern rendering: {PRIVATE_MODERN.credit}. <strong class="t-private">Draft preview; publication permission pending.</strong></>
          )}
          Sky drawn for the latitude of Oxford.
        </p>
      </footer>
    </div>
  </div>
</BaseLayout>

<style is:global>
  @font-face {
    font-family: "Junicode 2";
    src: url("/fonts/treatise/junicode/Junicode2-Roman.woff2") format("woff2");
    font-weight: 400 700;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "Texturina";
    src: url("/fonts/treatise/texturina/Texturina-VF.woff2") format("woff2");
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }
  @font-face {
    font-family: "EB Garamond";
