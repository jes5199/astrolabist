  }
  .gp-g {
    font-size: 1.14rem;
    font-weight: 500;
    color: #ffffff;
  }
  .gp-d {
    margin-top: 0.4rem !important;
    font-size: 0.96rem;
    color: #e0e4f3;
  }
  /* Commentary (Skeat's notes, his introduction), set apart from a definition. */
  .gp-d[data-kind="note"],
  .gp-d[data-kind="intro"] {
    margin-top: 0.55rem !important;
    padding-left: 0.7rem;
    border-left: 2px solid rgba(236, 201, 120, 0.5);
